/* ===== 倒立振子.mac ===== */
/* TAG: [LAGRANGIAN] ラグランジアン導出 */
depends(theta, t)$
T: 1/2 * m * l^2 * diff(theta, t)^2$
U: - m * g * l * cos(theta)$
L: T - U$
eq: diff(diff(L, diff(theta, t)), t) - diff(L, theta) = 0$
sol: solve(eq, diff(theta, t, 2))$

/* TAG: [EXPORT_PYTHON] fortran()でPython互換出力 */
accel_expr: rhs(sol[1])$
energy_expr: T + U$

s: openw("kinematics_core.py")$
printf(s, "# Auto-generated by Maxima~%")$
printf(s, "import numpy as np~%")$
printf(s, "from numpy import sin, cos~%~%")$
printf(s, "def get_accel(theta, m, l, g):~%")$
printf(s, "    return ~a~%~%", fortran(accel_expr))$
printf(s, "def get_energy(theta, omega, m, l, g):~%")$
printf(s, "    return ~a~%", fortran(subst([diff(theta,t)=omega], energy_expr)))$
close(s)$

/* TAG: [FIX_OPERATOR] ^ を ** に変換 */
system("sed -i 's/\\^/**/g' kinematics_core.py")$
print("Done: kinematics_core.py generated")$

