/* ===== C008: 連星系間重力エネルギー回収ネットワーク ===== */
/* αCen A/B連星の潮汐力発電とダイソン・スウォーム配置 */
/*
 * 計算の目的:
 *   αケンタウリA/B連星系の重力エネルギーを回収し、
 *   ダイソン・スウォームの最適配置を決定する。
 *
 * 物理モデル:
 *   1. 連星系の軌道エネルギー
 *      E_orbit = -G * M_A * M_B / (2 * a)
 *   2. 潮汐力によるエネルギー散逸
 *      P_tidal = (k * G^2 * M_A^2 * M_B^2 * (M_A + M_B)) / (a^5)
 *   3. ダイソン・スウォームの最適配置
 *      各恒星の周囲に配置し、エネルギーを回収
 *
 * パラメータ:
 *   M_A: αCen A質量 (1.08 M☉)
 *   M_B: αCen B質量 (0.91 M☉)
 *   a: 軌道長半径 (23.6 AU)
 *   e: 軌道離心率 (0.52)
 *
 * 注意:
 *   plot2dを使用（explicitは記号処理でエラーになるため）
 *   gridは数値指定（[grid,10,10]）
 */


kill(all);

/* ===== 物理定数 ===== */
G: 6.67430e-11;         /* 重力定数 [m^3/kg/s^2] */
Msun: 1.989e30;         /* 太陽質量 [kg] */
AU: 1.496e11;           /* 天文単位 [m] */
Lsun: 3.828e26;         /* 太陽光度 [W] */

/* ===== 連星系パラメータ ===== */
M_A: 1.08 * Msun;       /* αCen A質量 [kg] */
M_B: 0.91 * Msun;       /* αCen B質量 [kg] */
a_orbit: 23.6 * AU;     /* 軌道長半径 [m] */
e_orbit: 0.52;          /* 離心率 */

/* ===== 1. 軌道エネルギー ===== */
E_orbit: -G * M_A * M_B / (2 * a_orbit);
print("===== C008: 連星系間重力エネルギー回収 =====")$
print("軌道エネルギー E_orbit:", float(E_orbit), "[J]")$

/* ===== 2. 潮汐力によるエネルギー散逸 ===== */
P_tidal: (G^2 * M_A^2 * M_B^2 * (M_A + M_B)) / (a_orbit^5)$
print("潮汐力エネルギー散逸 P_tidal:", float(P_tidal), "[W]")$

/* ===== 3. ダイソン・スウォームの最適配置 ===== */
L_A: 1.52 * Lsun$
L_B: 0.50 * Lsun$

efficiency: 0.25$
Area_A: L_A / (efficiency * 1361)$
Area_B: L_B / (efficiency * 1361)$

printf(true, "αCen Aのダイソン・スウォーム必要面積: ~,2e [m^2]~%", float(Area_A))$
printf(true, "αCen Bのダイソン・スウォーム必要面積: ~,2e [m^2]~%", float(Area_B))$

/* ===== 4. 軌道半径の影響 ===== */
print("")$
print("軌道半径[AU]    潮汐力散逸[W]")$
print("------------------------------")$

a_samples: [10, 15, 20, 23.6, 30, 40, 50]$
for idx: 1 thru length(a_samples) do (
    a_val: a_samples[idx],
    a_m: a_val * AU,
    P: (G^2 * M_A^2 * M_B^2 * (M_A + M_B)) / (a_m^5),
    printf(true, "~8,1f        ~12,4e~%", a_val, float(P))
)$

/* ===== 5. 質量比の影響 ===== */
print("")$
print("質量比(M_B/M_A)  潮汐力散逸[W]")$
print("-------------------------------")$

ratio_samples: [0.5, 0.7, 0.84, 1.0, 1.2, 1.5]$
for idx: 1 thru length(ratio_samples) do (
    ratio_val: ratio_samples[idx],
    M_B_val: ratio_val * M_A,
    P: (G^2 * M_A^2 * M_B_val^2 * (M_A + M_B_val)) / (a_orbit^5),
    printf(true, "~8,2f          ~12,4e~%", ratio_val, float(P))
)$

/* ===== グラフ描画（plot2d使用）- 変数名を変更 ===== */
set_plot_option([plot_format, gnuplot])$

/* 軌道半径依存性 - 変数名を radius に変更 */
P_tidal_func(radius) := (G^2 * M_A^2 * M_B^2 * (M_A + M_B)) / (radius^5)$

plot2d(P_tidal_func(radius), [radius, 5*AU, 50*AU],
       [style, [lines, 2]],
       [color, blue],
       [legend, "潮汐力散逸"],
       [xlabel, "軌道半径 [AU]"],
       [ylabel, "散逸エネルギー [W]"],
       [title, "潮汐力エネルギー散逸（軌道半径依存性）"],
       [gnuplot_preamble, "set grid;"])$

/* 質量比依存性 - 変数名を r に変更 */
P_ratio_func(r) := (G^2 * M_A^2 * (r*M_A)^2 * (M_A + r*M_A)) / (a_orbit^5)$

plot2d(P_ratio_func(r), [r, 0.5, 1.5],
       [style, [lines, 2]],
       [color, red],
       [legend, "潮汐力散逸"],
       [xlabel, "質量比 (M_B/M_A)"],
       [ylabel, "散逸エネルギー [W]"],
       [title, "潮汐力エネルギー散逸（質量比依存性）"],
       [gnuplot_preamble, "set grid;"])$

/* 追加：軌道半径 vs 軌道エネルギー */
E_orbit_func(radius) := -G * M_A * M_B / (2 * radius)$

plot2d(E_orbit_func(radius), [radius, 5*AU, 50*AU],
       [style, [lines, 2]],
       [color, green],
       [legend, "軌道エネルギー"],
       [xlabel, "軌道半径 [AU]"],
       [ylabel, "エネルギー [J]"],
       [title, "軌道エネルギー（軌道半径依存性）"],
       [gnuplot_preamble, "set grid;"])$

/* ===== 考察 ===== */
print("")$
print("===== 考察 =====")$
printf(true, "1. αCen A/B連星系の軌道エネルギーは約 ~,2e J。~%", float(E_orbit))$
printf(true, "   これは太陽の年間出力の ~,2f 倍。~%", float(abs(E_orbit)/(Lsun*365.25*24*3600)))$
print("")$
print("2. 潮汐力によるエネルギー散逸は軌道半径の5乗に反比例。")$
print("   軌道が近づくほど、回収できるエネルギーが急増する。")$
print("")$
print("3. ダイソン・スウォームを各恒星の周囲に配置することで、")$
printf(true, "   合計 ~,2f L☉ のエネルギーを回収可能。~%", float((L_A + L_B)/Lsun))$
printf(true, "   これはプロキシマbダイソン環の約 ~,2f 倍。~%", float((L_A + L_B)/(0.0017*Lsun)))$
print("")$
print("4. 結論: αCen A/B連星系は、プロキシマbの次のエネルギー源として最適。")$
print("   潮汐力発電とダイソン・スウォームを併用することで、")$
print("   10^15 PW級のエネルギーを安定的に確保できる。")$
