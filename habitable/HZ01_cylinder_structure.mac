/* ============================================================
   HZ-01: オニールシリンダー構造力学
   目的：回転による遠心力と構造強度のバランスを計算し、
         実現可能な設計パラメータを導出する。
   仕様：
     - シリンダー半径 R = 5000m
     - 目標重力 g = 9.81 m/s^2
     - 回転角速度 ω = sqrt(g/R)
     - 構造材料: 高張力鋼/炭素繊維複合材
     - 遠心力による応力分布を計算
     - 実験実証の段階スケジュールを提示
   注意：
     - set_plot_option([plot_format, gnuplot]); で各グラフを別window表示
     - drawのsubplotはMaximaでエラーになるため使用しない
     - グラフはplot2dで個別に描画
     - 整数は~d、浮動小数点数は~fを使用
   出力:
     1. HZ01_results.csv: 構造力学計算結果
     2. HZ01_summary.txt: 計算サマリー
   ============================================================ */

kill(all);

/* グラフ表示設定 */
set_plot_option([plot_format, gnuplot]);

print("===== HZ-01: オニールシリンダー構造力学 =====")$
print("")$

/* ----- 基本パラメータ ----- */
print("--- 基本パラメータ ---")$

R : 5000;                            /* シリンダー半径 [m] */
L : 20000;                           /* シリンダー長さ [m] */
g_target : 9.81;                     /* 目標重力 [m/s^2] */
omega : sqrt(g_target / R);          /* 回転角速度 [rad/s] */
T_rotation : 2 * %pi / omega;        /* 回転周期 [s] */

/* 構造材料パラメータ（炭素繊維複合材） */
E_modulus : 150e9;                   /* ヤング率 [Pa] */
density : 1600;                      /* 密度 [kg/m^3] */
tensile_strength : 3.5e9;            /* 引張強度 [Pa] */
safety_factor : 2.0;                 /* 安全率 */

printf(true, "シリンダー半径: ~,0f m~%", R)$
printf(true, "シリンダー長さ: ~,0f m~%", L)$
printf(true, "目標重力: ~,2f m/s^2~%", g_target)$
printf(true, "回転角速度: ~,6f rad/s~%", omega)$
printf(true, "回転周期: ~,2f 秒 (~,2f 分)~%~%", T_rotation, T_rotation/60)$
printf(true, "材料: 炭素繊維複合材~%")$
printf(true, "  ヤング率: ~,2e Pa~%", E_modulus)$
printf(true, "  密度: ~,0f kg/m^3~%", density)$
printf(true, "  引張強度: ~,2e Pa~%", tensile_strength)$
printf(true, "  安全率: ~,1f~%~%", safety_factor)$

/* ----- 遠心力による応力計算 ----- */
print("--- 遠心力による応力計算 ---")$

/* 薄肉円筒の周方向応力: σ = ρ * ω^2 * R^2 */
/* ここでρは構造材密度、ωは角速度、Rは半径 */
sigma_hoop : density * omega^2 * R^2$

/* 許容応力 */
sigma_allowed : tensile_strength / safety_factor$

/* 必要肉厚: t = σ_hoop * R / σ_allowed */
/* 実際には内圧がないので、遠心力による応力のみ考慮 */
/* 遠心力による応力: σ = ρ * ω^2 * R^2 / 2 (円筒の場合) */
sigma_centrifugal : density * omega^2 * R^2 / 2$

/* 必要肉厚 */
t_required : sigma_centrifugal * R / sigma_allowed$

/* 構造質量 */
V_shell : 2 * %pi * R * L * t_required$
M_shell : V_shell * density$

printf(true, "遠心力による周方向応力: ~,2e Pa~%", sigma_centrifugal)$
printf(true, "許容応力 (安全率~,1f): ~,2e Pa~%", safety_factor, sigma_allowed)$
printf(true, "必要肉厚: ~,2f m (~,1f mm)~%", t_required, t_required*1000)$
printf(true, "構造体積: ~,2e m^3~%", V_shell)$
printf(true, "構造質量: ~,2e kg (~,2f 万トン)~%~%", M_shell, M_shell/1e7)$

/* ----- 内圧（大気圧）による応力 ----- */
print("--- 内圧（大気圧）による応力 ---")$

P_atm : 101325;                      /* 大気圧 [Pa] */
sigma_pressure : P_atm * R / t_required$

printf(true, "内圧 (1気圧): ~,0f Pa~%", P_atm)$
printf(true, "内圧による周方向応力: ~,2e Pa~%", sigma_pressure)$
printf(true, "合計応力: ~,2e Pa~%", sigma_centrifugal + sigma_pressure)$
printf(true, "許容応力に対する余裕: ~,1f%~%~%", 
       (sigma_allowed - (sigma_centrifugal + sigma_pressure)) / sigma_allowed * 100)$

/* ----- パラメータスイープ ----- */
print("--- パラメータスイープ ---")$

printf(true, "半径[km] | 肉厚[mm] | 構造質量[万トン] | 応力[MPa] | 安全率~%")$
printf(true, "---------+---------+----------------+----------+-------~%")$

for radius_km:1 thru 10 do block(
    [R_r, omega_r, sigma_r, t_r, M_r, sf_r],
    R_r : radius_km * 1000,
    omega_r : sqrt(g_target / R_r),
    sigma_r : density * omega_r^2 * R_r^2 / 2,
    t_r : sigma_r * R_r / sigma_allowed,
    M_r : 2 * %pi * R_r * L * t_r * density / 1e7,
    sf_r : sigma_allowed / sigma_r,
    printf(true, "~4,0f    | ~6,1f  | ~12,1f    | ~7,1f   | ~5,2f~%",
           radius_km, t_r*1000, M_r, sigma_r/1e6, sf_r)
)$
print("")$

/* ----- 実験実証スケジュール ----- */
print("--- 実験実証スケジュール ---")$

printf(true, "フェーズ | 期間 | 内容 | 規模~%")$
printf(true, "--------+------+------+------~%")$
printf(true, "Phase 1 | 2026-2030 | 地上遠心分離実験 | 10m直径~%")$
printf(true, "Phase 2 | 2031-2035 | 軌道上小型試験 | 100m直径~%")$
printf(true, "Phase 3 | 2036-2040 | 有人試験モジュール | 500m直径~%")$
printf(true, "Phase 4 | 2041-2050 | パイロットシリンダー | 2km直径~%")$
printf(true, "Phase 5 | 2051-2060 | 本格建設開始 | 5km直径~%")$
printf(true, "Phase 6 | 2061-2070 | 完成・運用開始 | 10km直径~%~%")$

/* ----- グラフ描画 ----- */
print("グラフ1: 半径vs必要肉厚 を表示します...")$

/* グラフ1: 半径vs肉厚 */
plot2d(
    density * (sqrt(g_target/r))^2 * r^2 / 2 * r / sigma_allowed * 1000, [r, 1000, 10000],
    [xlabel, "Radius [m]"],
    [ylabel, "Required Thickness [mm]"],
    [title, "Required Shell Thickness vs Radius"],
    [style, [lines, 2]],
    [color, blue])$

print("グラフ2: 半径vs構造質量 を表示します...")$

/* グラフ2: 半径vs質量 */
plot2d(
    2 * %pi * r * L * (density * (sqrt(g_target/r))^2 * r^2 / 2 * r / sigma_allowed) * density / 1e7, [r, 1000, 10000],
    [xlabel, "Radius [m]"],
    [ylabel, "Structural Mass [10^4 tons]"],
    [title, "Structural Mass vs Radius"],
    [style, [lines, 2]],
    [color, red])$

print("グラフ3: 半径vs安全率 を表示します...")$

/* グラフ3: 半径vs安全率 */
plot2d(
    sigma_allowed / (density * (sqrt(g_target/r))^2 * r^2 / 2), [r, 1000, 10000],
    [xlabel, "Radius [m]"],
    [ylabel, "Safety Factor"],
    [title, "Safety Factor vs Radius"],
    [style, [lines, 2]],
    [color, green])$

/* ----- CSV出力 ----- */
csv_file : "HZ01_results.csv"$
f_csv : openw(csv_file)$
printf(f_csv, "Radius_m,Thickness_mm,Mass_10kt,Safety_Factor~%")$
for radius_km:1 thru 10 do block(
    [R_r, omega_r, sigma_r, t_r, M_r, sf_r],
    R_r : radius_km * 1000,
    omega_r : sqrt(g_target / R_r),
    sigma_r : density * omega_r^2 * R_r^2 / 2,
    t_r : sigma_r * R_r / sigma_allowed,
    M_r : 2 * %pi * R_r * L * t_r * density / 1e7,
    sf_r : sigma_allowed / sigma_r,
    printf(f_csv, "~,0f,~,1f,~,1f,~,2f~%", R_r, t_r*1000, M_r, sf_r)
)$
close(f_csv)$
printf(true, "CSV保存: ~a~%", csv_file)$

/* ----- サマリー出力 ----- */
sum_file : "HZ01_summary.txt"$
f_sum : openw(sum_file)$
printf(f_sum, "HZ-01: オニールシリンダー構造力学 サマリー~%")$
printf(f_sum, "========================================~%~%")$
printf(f_sum, "【基本パラメータ】~%")$
printf(f_sum, "  シリンダー半径: ~,0f m~%", R)$
printf(f_sum, "  シリンダー長さ: ~,0f m~%", L)$
printf(f_sum, "  目標重力: ~,2f m/s^2~%", g_target)$
printf(f_sum, "  回転周期: ~,2f 分~%~%", T_rotation/60)$
printf(f_sum, "【構造計算結果】~%")$
printf(f_sum, "  遠心力応力: ~,2e Pa~%", sigma_centrifugal)$
printf(f_sum, "  必要肉厚: ~,1f mm~%", t_required*1000)$
printf(f_sum, "  構造質量: ~,2f 万トン~%~%", M_shell/1e7)$
printf(f_sum, "【実験実証スケジュール】~%")$
printf(f_sum, "  Phase 1 (2026-2030): 地上遠心分離実験 (10m)~%")$
printf(f_sum, "  Phase 2 (2031-2035): 軌道上小型試験 (100m)~%")$
printf(f_sum, "  Phase 3 (2036-2040): 有人試験モジュール (500m)~%")$
printf(f_sum, "  Phase 4 (2041-2050): パイロットシリンダー (2km)~%")$
printf(f_sum, "  Phase 5 (2051-2060): 本格建設開始 (5km)~%")$
printf(f_sum, "  Phase 6 (2061-2070): 完成・運用開始 (10km)~%~%")$
printf(f_sum, "【結論】~%")$
printf(f_sum, "半径~,0fmのオニールシリンダーは、炭素繊維複合材で~%", R)$
printf(f_sum, "肉厚~,1fmm、質量~,2f万トンで実現可能。~%", t_required*1000, M_shell/1e7)$
printf(f_sum, "実験実証には約40年かかる見込み。~%")$
close(f_sum)$
printf(true, "サマリー保存: ~a~%", sum_file)$

/* ----- 完了 ----- */
print("")$
print("===== HZ-01 計算完了 =====")$
print("出力ファイル:")$
printf(true, "  1. ~a~%", csv_file)$
printf(true, "  2. ~a~%", sum_file)$
print("  グラフは別windowで表示済み")$
