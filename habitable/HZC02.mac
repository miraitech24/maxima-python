/* ============================================================
   auto_20260831_110752: シェル厚計算とグラフ描画（完全修正版）
   ============================================================ */

kill(all);
numer: true;

/* ============================================================
   1. パラメータ設定
   ============================================================ */

D_km: 10;       /* シェル直径 [km] */
P_atm: 1;       /* 気圧 [atm] */
R_shield: 0.1;  /* シールド効率 [g/cm²] */
rho: 2.7;       /* 密度 [g/cm³]（アルミニウム） */

/* ============================================================
   2. シェル厚と総質量の計算
   ============================================================ */

d_cm: sqrt(D_km) * R_shield;
R_cm: (D_km * 100000) / 2;
V_cm3: 4 * %pi * R_cm^2 * d_cm;
M_shell_kg: V_cm3 * rho / 1000;

/* ============================================================
   3. 結果表示
   ============================================================ */

print("")$
print("========================================")$
print("  シェル厚計算結果")$
print("========================================")$
print("")$

printf(true, "【入力パラメータ】~%")$
printf(true, "  シェル直径:   ~,1f km~%", D_km)$
printf(true, "  気圧:         ~,1f atm~%", P_atm)$
printf(true, "  シールド効率: ~,1f g/cm²~%", R_shield)$
printf(true, "  密度:         ~,1f g/cm³ (アルミニウム)~%", rho)$
print("")$

printf(true, "【計算結果】~%")$
printf(true, "  シェル厚:     ~,4f cm~%", d_cm)$
printf(true, "  総質量:       ~,2e kg~%", M_shell_kg)$
printf(true, "  総質量:       ~,2e トン~%", M_shell_kg/1000)$
printf(true, "  総質量:       ~,2f 万トン~%", M_shell_kg/1000/10000)$
print("")$

/* ============================================================
   4. パラメータスイープ（修正済み）
   ============================================================ */

print("========================================")$
print("  パラメータスイープ結果")$
print("========================================")$
print("")$

/* ---- 直径スイープ（修正済み） ---- */
print("【直径 vs シェル厚】")$
print("  直径[km]  シェル厚[cm]  総質量[kg]")$
print("  -----------------------------------")$

for D_val in [5, 10, 15, 20, 30, 50] do (
    d_val: sqrt(D_val) * R_shield,
    R_cm_val: (D_val * 100000) / 2,
    V_val: 4 * %pi * R_cm_val^2 * d_val,
    M_val: V_val * rho / 1000,
    printf(true, "  ~4,0f       ~8,4f      ~12,2e~%", D_val, d_val, M_val)
)$

print("")$

/* ---- シールド効率スイープ（修正済み） ---- */
print("【シールド効率 vs シェル厚】")$
print("  効率[g/cm²]  シェル厚[cm]  総質量[kg]")$
print("  --------------------------------------")$

for R_val in [0.05, 0.1, 0.2, 0.3, 0.5, 1.0] do (
    d_val: sqrt(D_km) * R_val,
    R_cm_val: (D_km * 100000) / 2,
    V_val: 4 * %pi * R_cm_val^2 * d_val,
    M_val: V_val * rho / 1000,
    printf(true, "  ~5,2f        ~8,4f      ~12,2e~%", R_val, d_val, M_val)
)$

print("")$

/* ---- 気圧スイープ（追加） ---- */
print("【気圧 vs シェル厚】")$
print("  気圧[atm]  シェル厚[cm]  総質量[kg]")$
print("  -----------------------------------")$

/* 気圧はシェル厚に影響しないが、設計パラメータとして表示 */
for P_val in [0.5, 1.0, 2.0, 5.0, 10.0] do (
    printf(true, "  ~6,1f       ~8,4f      ~12,2e~%", P_val, d_cm, M_shell_kg)
)$

print("")$

/* ============================================================
   5. グラフ描画
   ============================================================ */

set_plot_option([plot_format, gnuplot])$

/* グラフ1: 直径 vs シェル厚 */
print("グラフ1: 直径 vs シェル厚")$
d_func(D) := sqrt(D) * R_shield$
plot2d(d_func(D), [D, 1, 60],
       [style, [lines, 2]],
       [color, blue],
       [legend, "シェル厚"],
       [xlabel, "シェル直径 [km]"],
       [ylabel, "シェル厚 [cm]"],
       [title, "シェル厚の直径依存性"],
       [gnuplot_preamble, "set grid;"])$

/* グラフ2: 直径 vs 総質量 */
print("グラフ2: 直径 vs 総質量")$
M_func(D) := block(
    [R_cm_val: (D * 100000) / 2,
     d_val: sqrt(D) * R_shield,
     V_val: 4 * %pi * R_cm_val^2 * d_val],
    return(V_val * rho / 1000)
)$

plot2d(M_func(D)/1e9, [D, 1, 60],
       [style, [lines, 2]],
       [color, red],
       [legend, "総質量"],
       [xlabel, "シェル直径 [km]"],
       [ylabel, "総質量 [10^9 kg]"],
       [title, "総質量の直径依存性"],
       [gnuplot_preamble, "set grid;"])$

/* グラフ3: シールド効率 vs シェル厚 */
print("グラフ3: シールド効率 vs シェル厚")$
d_func_R(R) := sqrt(D_km) * R$
plot2d(d_func_R(R), [R, 0.01, 1.0],
       [style, [lines, 2]],
       [color, green],
       [legend, "シェル厚"],
       [xlabel, "シールド効率 [g/cm²]"],
       [ylabel, "シェル厚 [cm]"],
       [title, "シェル厚のシールド効率依存性"],
       [gnuplot_preamble, "set grid;"])$

/* グラフ4: シールド効率 vs 総質量 */
print("グラフ4: シールド効率 vs 総質量")$
M_func_R(R) := block(
    [R_cm_val: (D_km * 100000) / 2,
     d_val: sqrt(D_km) * R,
     V_val: 4 * %pi * R_cm_val^2 * d_val],
    return(V_val * rho / 1000)
)$

plot2d(M_func_R(R)/1e9, [R, 0.01, 1.0],
       [style, [lines, 2]],
       [color, magenta],
       [legend, "総質量"],
       [xlabel, "シールド効率 [g/cm²]"],
       [ylabel, "総質量 [10^9 kg]"],
       [title, "総質量のシールド効率依存性"],
       [gnuplot_preamble, "set grid;"])$

/* グラフ5: 直径 vs シェル厚と総質量（比較） */
print("グラフ5: 直径 vs シェル厚と総質量（比較）")$
plot2d([d_func(D), M_func(D)/1e9], [D, 1, 60],
       [style, [lines, 2], [lines, 2]],
       [color, blue, red],
       [legend, "シェル厚 [cm]", "総質量 [10^9 kg]"],
       [xlabel, "シェル直径 [km]"],
       [ylabel, "値"],
       [title, "直径依存性（比較）"],
       [gnuplot_preamble, "set grid; set yrange [0:];"])$

/* ============================================================
   6. 結論
   ============================================================ */

print("")$
print("========================================")$
print("  結論")$
print("========================================")$
print("")$

printf(true, "1. シェル厚は直径の平方根に比例: d_cm = ~,3f * sqrt(D_km)~%", R_shield)$
printf(true, "2. 総質量は直径の2.5乗に比例 (d_cm × R_cm² のため)~%")$
printf(true, "3. シールド効率を上げるとシェル厚と質量が比例増加~%")$
printf(true, "4. 気圧はシェル厚に直接影響しない（内部構造で考慮）~%")$
printf(true, "5. 直径10km, 効率0.1g/cm²の場合:~%")$
printf(true, "   - シェル厚: ~,4f cm~%", d_cm)$
printf(true, "   - 総質量: ~,2e kg (~,2f 万トン)~%", M_shell_kg, M_shell_kg/1000/10000)$
print("")$

printf(true, "【設計への示唆】~%")$
printf(true, "  - 大規模シェル（>50km）は質量が急増するため非現実的~%")$
printf(true, "  - シールド効率は0.1-0.3g/cm²が現実的な範囲~%")$
printf(true, "  - 軽量素材（カーボンナノチューブ等）の開発が鍵~%")$
printf(true, "  - 気圧は内部構造設計で独立して考慮可能~%")$
print("")$
print("========================================")$
