/* ===== SIM-003 自動運転システムの安全性検証 ===== */
/* モンテカルロシミュレーションによる衝突リスク評価 */

kill(all);

/* パラメータ設定 */
N_sim: 1000$

/* 車両パラメータ */
v_vehicle: 30.0$    /* 車両速度 [m/s] */
t_response: 0.5$    /* 反応時間 [s] */
a_max: -8.0$        /* 最大減速度 [m/s^2] */

/* シナリオパラメータ */
p_pedestrian: 0.1$
p_bad_weather: 0.2$
p_sudden_brake: 0.05$

/* 乱数シード設定 */
set_random_state(make_random_state(42))$

/* 停止距離の計算 */
d_stop_base: v_vehicle * t_response + v_vehicle^2 / (2 * abs(a_max))$

print("=== 基本停止距離 ===")$
print("d_stop_base = ", d_stop_base, " [m]")$

/* シミュレーション */
collision_count: 0$
total_distance: 0$
min_distance: 1000$
max_distance: 0$
distances: []$

for i: 1 thru N_sim do (
    weather_factor: 1.0,
    if random(1.0) < p_bad_weather then
        weather_factor: 1.3,
    
    has_pedestrian: random(1.0) < p_pedestrian,
    has_sudden_brake: random(1.0) < p_sudden_brake,
    obstacle_distance: 10 + random(50),
    d_stop: d_stop_base * weather_factor,
    
    if d_stop > obstacle_distance then
        collision_count: collision_count + 1,
    
    distances: append(distances, [d_stop]),
    total_distance: total_distance + d_stop,
    if d_stop < min_distance then min_distance: d_stop,
    if d_stop > max_distance then max_distance: d_stop
)$

/* 結果表示 */
print("=== モンテカルロシミュレーション結果 ===")$
print("シミュレーション回数: ", N_sim)$
print("衝突回数: ", collision_count)$
collision_rate: float(collision_count / N_sim)$
print("衝突確率: ", collision_rate)$
print("平均停止距離: ", float(total_distance / N_sim), " [m]")$
print("最小停止距離: ", min_distance, " [m]")$
print("最大停止距離: ", max_distance, " [m]")$

/* 信頼区間 */
p_hat: collision_rate$
se: sqrt(p_hat * (1 - p_hat) / N_sim)$
ci_lower: p_hat - 1.96 * se$
ci_upper: p_hat + 1.96 * se$
print("95%信頼区間: [", float(ci_lower), ", ", float(ci_upper), "]")$

/* ===== グラフ描画 ===== */
set_plot_option([plot_format, gnuplot])$

/* ----- グラフ1: ヒストグラム（点と線で代用） ----- */
print("グラフ1: 停止距離のヒストグラムを表示します...")$

/* ヒストグラム用データ */
bin_width: 2.0$
bins: makelist(bin_width * k, k, 0, 20)$
hist_data: makelist(0, k, 1, 20)$

for i: 1 thru N_sim do (
    for k: 1 thru 20 do (
        if distances[i] >= bins[k] and distances[i] < bins[k+1] then
            hist_data[k]: hist_data[k] + 1
    )
)$

/* ビンの中心と頻度のペア */
bin_centers: makelist((bins[k] + bins[k+1])/2, k, 1, 20)$
hist_points: makelist([bin_centers[k], hist_data[k]], k, 1, 20)$

/* ヒストグラム: impulsesスタイルを使用 */
plot2d([discrete, hist_points],
       [style, [impulses, 2, 1]],
       [color, blue],
       [xlabel, "Stop Distance [m]"],
       [ylabel, "Frequency"],
       [title, "Distribution of Stopping Distance"],
       [gnuplot_preamble, "set key outside; set grid;"],
       [legend, "Frequency"])$

/* ----- グラフ2: 累積分布関数 ----- */
print("グラフ2: 累積分布関数を表示します...")$

cumulative: makelist(0, k, 1, 20)$
cumulative[1]: hist_data[1]$
for k: 2 thru 20 do (
    cumulative[k]: cumulative[k-1] + hist_data[k]
)$

cumulative_norm: makelist(float(cumulative[k] / N_sim), k, 1, 20)$
cdf_points: makelist([bin_centers[k], cumulative_norm[k]], k, 1, 20)$

plot2d([discrete, cdf_points],
       [style, [lines, 2]],
       [color, red],
       [xlabel, "Stop Distance [m]"],
       [ylabel, "Cumulative Probability"],
       [title, "Cumulative Distribution Function"],
       [gnuplot_preamble, "set key outside; set grid;"],
       [legend, "CDF"])$

/* ----- グラフ3: 衝突リスク（impulsesで代用） ----- */
print("グラフ3: 衝突リスク評価を表示します...")$

/* データ作成 */
risk_collision: [1, collision_rate]$
risk_no_collision: [2, 1 - collision_rate]$

/* impulsesスタイルで描画 */
plot2d([[discrete, [risk_collision]], [discrete, [risk_no_collision]]],
       [style, [impulses, 3, 1], [impulses, 3, 1]],
       [color, red, green],
       [xlabel, ""],
       [ylabel, "Probability"],
       [title, "Collision Risk Assessment"],
       [gnuplot_preamble, "set key outside; set grid; set xtics ('Collision' 1, 'No Collision' 2);"],
       [legend, "Collision", "No Collision"])$

/* ----- グラフ4: 停止距離と障害物距離の散布図 ----- */
print("グラフ4: 停止距離と障害物距離の比較を表示します...")$

/* データ生成 */
obstacle_distances: makelist(10 + random(50), i, 1, N_sim)$
stop_distances: makelist(d_stop_base * (if random(1.0) < p_bad_weather then 1.3 else 1.0), i, 1, N_sim)$

scatter_data: makelist([obstacle_distances[i], stop_distances[i]], i, 1, min(N_sim, 200))$  /* 200点に制限 */

/* 境界線データ */
boundary_line: [[0,0], [60,60]]$

plot2d([discrete, scatter_data, [discrete, boundary_line]],
       [style, [points, 1, 1], [lines, 2]],
       [color, blue, red],
       [xlabel, "Obstacle Distance [m]"],
       [ylabel, "Stop Distance [m]"],
       [title, "Stop Distance vs Obstacle Distance"],
       [gnuplot_preamble, "set key outside; set grid; set size ratio -1;"],
       [legend, "Simulation", "y=x (Boundary)"])$

/* ----- グラフ5: 箱ひげ図（代わりにエラーバー風） ----- */
print("グラフ5: 停止距離の統計サマリーを表示します...")$

/* パーセンタイル計算 */
sorted_distances: sort(distances)$
p25: sorted_distances[floor(N_sim*0.25)]$
p50: sorted_distances[floor(N_sim*0.50)]$
p75: sorted_distances[floor(N_sim*0.75)]$

/* エラーバー用データ */
stats_data: [[1, p50, p25, p75, min_distance, max_distance]]$

plot2d([discrete, stats_data],
       [style, [points, 3, 1]],
       [color, blue],
       [xlabel, ""],
       [ylabel, "Stop Distance [m]"],
       [title, "Stop Distance Statistics"],
       [gnuplot_preamble, "set key outside; set grid; set xtics ('Summary' 1); set yrange [0:];"],
       [legend, "Median (IQR)"])$

/* ===== 結果表示 ===== */
print("")$
print("=== 考察 ===")$
print("モンテカルロシミュレーションにより、自動運転システムの衝突リスクを")$
print("統計的に評価した。")$
print("")$
printf(true, "結果:~%")$
printf(true, "  - 衝突確率: 約 ~,2f%%~%", collision_rate*100)$
printf(true, "  - 平均停止距離: 約 ~,2f m~%", float(total_distance/N_sim))$
printf(true, "  - 中央値: ~,2f m~%", p50)$
printf(true, "  - 四分位範囲: ~,2f - ~,2f m~%", p25, p75)$
print("")$
print("この結果から、以下の改善策が考えられる:")$
print("  1. 反応時間の短縮（センサー性能向上）")$
print("  2. 制動性能の向上（ブレーキシステム改善）")$
print("  3. 天候センサーによる速度制御")$
print("  4. 歩行者検知システムの強化")$
print("")$
print("安全性の目標値（衝突確率 < 0.01%）を達成するには、")$
print("さらなるシミュレーションとパラメータ最適化が必要である。")$
