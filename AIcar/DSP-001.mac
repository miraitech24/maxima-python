
/* ===== DSP-001 リアルタイム配車最適化 ===== */
/* 複数車両への配車割り当てを最適化（ハンガリアン法） */

/* 仕様:
   複数の車両と配車リクエストがあり、各車両から各リクエストへの
   移動コスト（時間・距離）が与えられたとき、総コスト最小となる
   割り当てを求める。
   これは割当問題（Assignment Problem）であり、ハンガリアン法で解く。
*/

/* コスト行列（車両i → リクエストj の移動コスト） */
/* 例: 3台の車両、3つのリクエスト */
C: matrix([5, 9, 3],
          [8, 2, 7],
          [4, 6, 1])$

/* コスト行列の表示 */
print("=== コスト行列（車両×リクエスト） ===")$
print(C)$

/* ハンガリアン法による最適割当 */
/* Maximaには組み込みのハンガリアン法がないため、 */
/* 線形計画法（simplex）で解く */

load(simplex)$

/* 割当変数 x[i,j] ∈ {0,1} */
/* 目的関数: 総コスト最小化 */
/* 制約: 各車両は1つのリクエストに、各リクエストは1つの車両に */

/* 変数定義 */
x11: x[1,1]$ x12: x[1,2]$ x13: x[1,3]$
x21: x[2,1]$ x22: x[2,2]$ x23: x[2,3]$
x31: x[3,1]$ x32: x[3,2]$ x33: x[3,3]$

/* 目的関数: 総コスト最小化 */
obj: 5*x11 + 9*x12 + 3*x13 +
     8*x21 + 2*x22 + 7*x23 +
     4*x31 + 6*x32 + 1*x33$

/* 制約条件 */
/* 各車両は1つのリクエストに割り当て */
c1: x11 + x12 + x13 = 1$
c2: x21 + x22 + x23 = 1$
c3: x31 + x32 + x33 = 1$

/* 各リクエストは1つの車両に割り当て */
c4: x11 + x21 + x31 = 1$
c5: x12 + x22 + x32 = 1$
c6: x13 + x23 + x33 = 1$

/* 0-1制約 */
c7: x11 >= 0$ c8: x11 <= 1$
c9: x12 >= 0$ c10: x12 <= 1$
c11: x13 >= 0$ c12: x13 <= 1$
c13: x21 >= 0$ c14: x21 <= 1$
c15: x22 >= 0$ c16: x22 <= 1$
c17: x23 >= 0$ c18: x23 <= 1$
c19: x31 >= 0$ c20: x31 <= 1$
c21: x32 >= 0$ c22: x32 <= 1$
c23: x33 >= 0$ c24: x33 <= 1$

/* 線形計画法で求解 */
sol: maximize_lp(obj, [c1, c2, c3, c4, c5, c6, c7, c8, c9, c10,
                       c11, c12, c13, c14, c15, c16, c17, c18,
                       c19, c20, c21, c22, c23, c24])$

print("=== 最適化結果 ===")$
print("最適総コスト: ", -sol[1])$
print("割当結果:")$
print(sol[2])$

/* 割当の解釈 */
/* 各車両の割当先を表示 */
print("=== 車両ごとの割当 ===")$
for i: 1 thru 3 do (
    for j: 1 thru 3 do (
        if abs(rhs(sol[2][(i-1)*3+j])) > 0.5 then
            print("車両", i, "→ リクエスト", j, "(コスト:", C[i,j], ")")
    )
)$

/* グラフ表示: コスト行列の可視化 */
set_plot_option([plot_format, gnuplot])$

/* コスト行列の棒グラフ（修正版: barsの代わりにpointsで表示） */
plot2d([discrete, makelist([i, C[1,i]], i, 1, 3),
              makelist([i, C[2,i]], i, 1, 3),
              makelist([i, C[3,i]], i, 1, 3)],
       [style, [points, 2, 1], [points, 2, 2], [points, 2, 3]],
       [color, red, green, blue],
       [legend, "車両1", "車両2", "車両3"],
       [xlabel, "リクエスト番号"],
       [ylabel, "移動コスト"],
       [title, "配車コスト行列"],
       [gnuplot_preamble, "set key outside;"])$

/* 最適割当の可視化 */
/* 割当結果をバイナリ行列として表示 */
assign_matrix: zeromatrix(3, 3)$
for i: 1 thru 3 do (
    for j: 1 thru 3 do (
        if abs(rhs(sol[2][(i-1)*3+j])) > 0.5 then
            assign_matrix[i, j]: 1
    )
)$

print("=== 割当行列（1が割当） ===")$
print(assign_matrix)$

/* 割当のネットワーク図 */
/* 車両とリクエストの関係をグラフで表示 */
edges: []$
for i: 1 thru 3 do (
    for j: 1 thru 3 do (
        if assign_matrix[i, j] = 1 then
            edges: append(edges, [[i, j]])
    )
)$

print("=== 割当エッジ ===")$
print(edges)$

/* 考察:
   ハンガリアン法（線形計画法による解法）により、
   総移動コストが最小となる車両-リクエスト割当を求めた。
   この結果を基に、実際の配車システムでは
   - リアルタイムの位置情報
   - 交通状況
   - 乗客の待ち時間
   などを考慮して動的に再計算する。
*/
