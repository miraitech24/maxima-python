/* 課題31: マクスウェル・ポンプ連成解析（パス特定版） */

/* 1. 物理定数の定義 */
P_surface : 92.0$
T_surface : 737.0$
gamma : 1.28$
V_base : 100000.0$
Q_flow : 500.0$
alpha : (gamma - 1) / gamma$

/* 2. ファイル出力 */
filename : "params_31.py"$
s : openw(filename)$
printf(s, "# Generated by Maxima for Task 31~%")$
printf(s, "P_SURFACE = ~f~%", float(P_surface))$
printf(s, "T_SURFACE = ~f~%", float(T_surface))$
printf(s, "GAMMA = ~f~%", float(gamma))$
printf(s, "K_DECAY = ~f~%", float(Q_flow / V_base))$
printf(s, "ALPHA = ~f~%", float(alpha))$
close(s)$

/* 3. 沼脱出用：パスの強制表示 */
print("--------------------------------------------------")$
print("【重要】ファイル出力チェック")$
/* 現在の作業ディレクトリを表示 */
print("現在のディレクトリ: ", directory("" ))$ 
print("作成したファイル名: ", filename)$
print("もし上記リストに無い場合は、以下を確認してください:")$
print(system("cd"))$ /* OSのコマンドで現在の場所を表示 */
print("--------------------------------------------------")$

/* グラフ表示も再開 */
plot2d(T_surface * (P / P_surface)^alpha, [P, 30, 92], [xlabel, "Pressure (atm)"], [ylabel, "Temp (K)"])$
