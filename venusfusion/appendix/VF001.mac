/* VF001_maxima_only_fixed.mac */
/* SR減衰の解析解と数値計算 - Maxima単独版（修正） */

/* 1. 基本パラメータ */
v0: 0.99;      /* 初期風速 */
k: 0.01;       /* 制動定数 */
n_max: 865;    /* 最大拠点数 */
t_end: 300;    /* シミュレーション期間（年） */

/* 2. 拠点数成長モデル */
/* 線形成長 */
n_linear(t) := 1 + (n_max - 1) * (t / t_end);

/* 指数成長 */
growth_rate: 0.05;
n_exponential(t) := 1 + (n_max - 1) * (1 - exp(-growth_rate * t));

/* ロジスティック成長（推奨） */
inflection_year: 150;
n_logistic(t) := 1 + (n_max - 1) / (1 + exp(-growth_rate * (t - inflection_year)));

/* 3. 微分方程式の解析解 */
/* 線形成長の場合の解析解 */
v_analytic_linear(t) := v0 * exp(-k * (0.5 * (n_max - 1)/t_end * t^2 + 1 * t));

/* 4. 数値解法（4次ルンゲクッタ法） */
runge_kutta(v_val, t_val, delta_t, n_func) := block(
    [k1, k2, k3, k4],
    k1: -k * n_func(t_val) * v_val,
    k2: -k * n_func(t_val + delta_t/2) * (v_val + k1*delta_t/2),
    k3: -k * n_func(t_val + delta_t/2) * (v_val + k2*delta_t/2),
    k4: -k * n_func(t_val + delta_t) * (v_val + k3*delta_t),
    v_val + (delta_t/6)*(k1 + 2*k2 + 2*k3 + k4)
);

/* 5. シミュレーション実行 */
simulate(growth_model_name, n_func) := block(
    [delta_t, steps, t_list, v_list, n_list, i],
    
    delta_t: 0.1,  /* 時間ステップ（年） */
    steps: floor(t_end / delta_t),
    
    t_list: makelist(i*delta_t, i, 0, steps),
    v_list: makelist(0.0, i, 0, steps),
    n_list: makelist(0.0, i, 0, steps),
    
    /* 初期値 */
    v_list[1]: v0,
    n_list[1]: float(n_func(0)),
    
    /* 数値積分 */
    for i:1 thru steps do (
        n_list[i]: float(n_func((i-1)*delta_t)),
        if i < steps then (
            v_list[i+1]: float(runge_kutta(v_list[i], (i-1)*delta_t, delta_t, n_func))
        )
    ),
    
    /* 結果をリストとして返す */
    [t_list, v_list, n_list]
);

/* 6. 各モデルのシミュレーション */
print("シミュレーション実行中...");
results_linear: simulate("linear", n_linear);
results_exp: simulate("exponential", n_exponential);
results_logistic: simulate("logistic", n_logistic);
print("シミュレーション完了");

/* 7. 解析解との比較 */
analytic_values: makelist(v_analytic_linear(t), t, 0, t_end, 10);

/* 8. 閾値到達時間の計算 */
find_threshold_time(v_list, t_list, threshold) := block(
    [i, found: false, t_threshold],
    for i:1 thru length(v_list) while not found do (
        if v_list[i] <= threshold then (
            t_threshold: t_list[i],
            found: true
        )
    ),
    if found then t_threshold else t_end
);

thresholds: [0.8, 0.5, 0.3, 0.1];
threshold_times_logistic: makelist(
    find_threshold_time(results_logistic[2], results_logistic[1], thresh),
    thresh, thresholds
);

/* 9. 結果の出力 */
print("VF-001: SR減衰シミュレーション結果 (Maxima単独)");
print("================================================");
print("");

print("パラメータ:");
printf(true, "  初期風速 v0 = ~f~%", v0);
printf(true, "  制動定数 k = ~f~%", k);
printf(true, "  最大拠点数 n_max = ~d~%", n_max);
printf(true, "  シミュレーション期間 = ~d 年~%", t_end);
print("");

print("閾値到達時間（ロジスティックモデル）:");
for i:1 thru length(thresholds) do (
    printf(true, "  風速 ~f 到達: ~f 年~%", 
           thresholds[i], threshold_times_logistic[i])
);

print("");
print("最終風速（各モデル）:");
printf(true, "  線形成長モデル: ~f~%", last(results_linear[2]));
printf(true, "  指数成長モデル: ~f~%", last(results_exp[2]));
printf(true, "  ロジスティックモデル: ~f~%", last(results_logistic[2]));

/* 10. ファイルへの出力 */
/* データをCSV形式で保存 */
with_stdout("VF001_results.csv",
    printf(true, "t,linear_v,exp_v,logistic_v,linear_n,exp_n,logistic_n~%"),
    for i:1 step 30 thru length(results_linear[1]) do (  /* 間引いて出力 */
        t_val: results_linear[1][i],
        printf(true, "~f,~f,~f,~f,~f,~f,~f~%",
               t_val,
               results_linear[2][i],
               results_exp[2][i],
               results_logistic[2][i],
               n_linear(t_val),
               n_exponential(t_val),
               n_logistic(t_val))
    )
);

/* 閾値到達時間の保存 */
with_stdout("VF001_thresholds.txt",
    printf(true, "閾値,到達時間(年)~%"),
    for i:1 thru length(thresholds) do (
        printf(true, "~f,~f~%", thresholds[i], threshold_times_logistic[i])
    )
);

/* 11. グラフの生成（gnuplotを使用） */
load("draw");

/* 風速の比較グラフ */
draw2d(
    terminal = png,
    file_name = "VF001_wind_speeds",
    title = "VF-001: SR風速減衰シミュレーション",
    xlabel = "時間 (年)",
    ylabel = "SR風速",
    yrange = [0, 1.1],
    points_joined = true,
    color = red,
    point_type = none,
    line_width = 2,
    key = "線形成長",
    points(results_linear[1], results_linear[2]),
    color = blue,
    key = "指数成長",
    points(results_exp[1], results_exp[2]),
    color = green,
    key = "ロジスティック成長",
    points(results_logistic[1], results_logistic[2])
);

/* 拠点数成長のグラフ */
draw2d(
    terminal = png,
    file_name = "VF001_base_growth",
    title = "VF-001: 拠点数成長モデル",
    xlabel = "時間 (年)",
    ylabel = "拠点数",
    yrange = [0, 900],
    points_joined = true,
    color = red,
    point_type = none,
    line_width = 2,
    key = "線形成長",
    explicit(n_linear(x), x, 0, t_end),
    color = blue,
    key = "指数成長",
    explicit(n_exponential(x), x, 0, t_end),
    color = green,
    key = "ロジスティック成長",
    explicit(n_logistic(x), x, 0, t_end)
);

/* 12. 詳細解析 */
/* エネルギー散逸率の計算 */
t_list: results_logistic[1];
v_list: results_logistic[2];
n_list: results_logistic[3];

energy_dissipation: makelist(k * n_list[i] * v_list[i]^2, i, 1, length(t_list));

/* 累積エネルギー（台形積分） */
cumulative_energy: 0.0;
for i:2 thru length(t_list) do (
    dt: t_list[i] - t_list[i-1],
    avg_power: (energy_dissipation[i] + energy_dissipation[i-1]) / 2,
    cumulative_energy: cumulative_energy + avg_power * dt
);

print("");
print("エネルギー解析（ロジスティックモデル）:");
printf(true, "  最大散逸率: ~e~%", lmax(energy_dissipation));
printf(true, "  累積エネルギー: ~e~%", cumulative_energy);

/* 13. 終了メッセージ */
print("");
print("================================================");
print("✅ VF-001 完了");
print("生成されたファイル:");
print("  1. VF001_results.csv - シミュレーションデータ");
print("  2. VF001_thresholds.txt - 閾値到達時間");
print("  3. VF001_wind_speeds.png - 風速グラフ");
print("  4. VF001_base_growth.png - 拠点数成長グラフ");

