/* [wxMaxima: input   start ] */
/* 1. CO2分解に必要なエネルギー (標準生成エンタルピー ΔH = 393.5 kJ/mol) */
/* 金星の大気圧からモル数 n を概算する式 */
assume(P_v > 0, A_v > 0, g_v > 0, delta_H > 0);
n_co2: (P_v * A_v) / (M_co2 * g_v);
E_decomp: n_co2 * delta_H;

/* 2. 人工太陽（核融合炉）の放射エネルギー */
/* 半径 R, 温度 T の黒体放射 */
E_sun: 4 * %pi * R^2 * sigma * T^4;

/* 3. 地球への伝送損失 (距離 L による減衰) */
E_earth: E_sun * (A_receptor / (4 * %pi * L^2));

/* Pythonへ式を渡す */
string_out: string([E_decomp, E_earth]);
writefile("formula_10.txt");
print(string_out);
closefile();
/* [wxMaxima: input   end   ] */



