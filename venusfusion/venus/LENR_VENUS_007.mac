/* ============================================================ */
/* LENR-VENUS-007: 熱電変換効率の最適化計算（高温差利用）          */
/* 山頂(350℃) - 高度55km(25℃) 温度差325K                        */
/* Maxima版: 記号処理ルールに従い、数値は後で代入                */
/* 注意: Maximaの沼（floatとシンボル、diffの評価タイミング）回避 */
/* ============================================================ */

print("=== LENR-VENUS-007: 熱電変換効率の最適化計算 ===")$
print("山頂(350℃) - 高度55km(25℃) 温度差利用")$
print("")$

/* ---- 1. 温度条件 ---- */
T_hot : 350 + 273.15;  /* 山頂温度 (K) = 623.15K */
T_cold : 25 + 273.15;  /* 高度55km温度 (K) = 298.15K */
dT : float(T_hot - T_cold);  /* 温度差 (K) */

print("温度条件:")$
print("  高温側:", float(T_hot - 273.15), "℃ (", T_hot, "K)")$
print("  低温側:", float(T_cold - 273.15), "℃ (", T_cold, "K)")$
print("  温度差:", float(dT), "K")$
print("")$

/* ---- 2. カルノー効率（理論最大） ---- */
eta_carnot : float(1 - T_cold / T_hot);
print("カルノー効率（理論最大）:", float(eta_carnot * 100), "%")$

/* ---- 3. 熱電変換材料の性能比較 ---- */
/* 性能指数 ZT = S^2 * sigma * T / kappa */
/* S: ゼーベック係数, sigma: 電気伝導率, kappa: 熱伝導率 */

print("")$
print("=== 熱電変換材料の性能比較 ===")$
print("材料, ZT(350℃), 最大効率(%), 備考")$

/* 材料データ: [名前, ZT@350℃, 備考] */
materials : [
    ["Bi2Te3",       0.8,  "低温域で高性能、350℃では劣化"],
    ["PbTe",         1.2,  "中温域で安定、350℃に適する"],
    ["Skutterudite", 1.0,  "中温域、機械的強度に課題"],
    ["SiGe",         0.6,  "高温域、効率は低いが安定"],
    ["Mg2Si",        0.7,  "低コスト、資源豊富"],
    ["Half-Heusler", 1.1,  "高強度、中温域で有望"],
    ["SnSe",         1.5,  "高ZT、異方性に注意"],
    ["TAGS",         1.3,  "軍事用、高コスト"]
]$

for mat in materials do (
    name : mat[1],
    ZT : mat[2],
    note : mat[3],
    /* 最大効率 eta_max = (T_hot - T_cold)/T_hot * (sqrt(1+ZT) - 1)/(sqrt(1+ZT) + T_cold/T_hot) */
    eta_max : float(dT / T_hot * (sqrt(1 + ZT) - 1) / (sqrt(1 + ZT) + T_cold / T_hot)),
    print(concat(name, ", ", ZT, ", ", float(eta_max * 100), ", ", note))
)$

/* ---- 4. 最適化計算 ---- */
/* 負荷抵抗比 m = R_load / R_internal の最適化 */
print("")$
print("=== 負荷抵抗比の最適化 ===")$
print("m (負荷抵抗比), 出力電力比, 効率")$

/* 最適負荷抵抗比 m_opt = sqrt(1 + ZT) */
/* PbTe (ZT=1.2) を代表例として計算 */
ZT_opt : 1.2$
m_opt : float(sqrt(1 + ZT_opt));
print("最適負荷抵抗比 m_opt =", float(m_opt))$

/* 各mに対する出力と効率 */
for m : 0.5 thru 2.5 step 0.25 do (
    P_ratio : float(m / (1 + m)^2 * (1 + ZT_opt * (1 + m) / (m + T_cold/T_hot * (1 + m)^2))),
    eta : float(dT / T_hot * (m / (1 + m)) / (1 + (1 + m)^2 / (ZT_opt * m) * T_cold / T_hot)),
    print(concat(m, ", ", float(P_ratio * 100), "%, ", float(eta * 100), "%"))
)$

/* ---- 5. 多段熱電変換の検討 ---- */
print("")$
print("=== 多段熱電変換の検討 ===")$
print("段数, 理論効率(%), 実効率(%), 備考")$

for stages : 1 thru 5 do (
    /* 各段の温度差を均等分割 */
    dT_stage : float(dT / stages),
    T_hot_stage : T_hot,
    eta_stage_total : 0,
    for s : 1 thru stages do (
        T_cold_stage : float(T_hot_stage - dT_stage),
        eta_stage : float(dT_stage / T_hot_stage * (sqrt(1 + ZT_opt) - 1) / (sqrt(1 + ZT_opt) + T_cold_stage / T_hot_stage)),
        eta_stage_total : eta_stage_total + eta_stage * (1 - eta_stage_total),
        T_hot_stage : T_cold_stage
    ),
    eta_practical : float(eta_stage_total * 0.8),  /* 実効率は理論の80% */
    note : if stages = 1 then "単段" else concat(stages, "段"),
    print(concat(stages, ", ", float(eta_stage_total * 100), ", ", float(eta_practical * 100), ", ", note))
)$

/* ---- 6. 熱電変換モジュール設計 ---- */
print("")$
print("=== 熱電変換モジュール設計 ===")$
/* 発電目標: LENR-VENUS-016 より 正味出力 約4.5kW */
P_target : 4500;  /* 目標出力 (W) */

/* PbTeモジュールの特性（想定） */
V_module : 0.5;     /* 1モジュールの出力電圧 (V) */
I_module : 5.0;     /* 1モジュールの出力電流 (A) */
P_module : float(V_module * I_module);  /* 1モジュールの出力 (W) */
eta_module : 0.12;  /* モジュール効率 12% */

print("目標出力:", P_target, "W")$
print("1モジュール出力:", float(P_module), "W")$
print("モジュール効率:", eta_module * 100, "%")$

/* 必要モジュール数 */
N_modules : float(ceil(P_target / P_module));
print("必要モジュール数:", N_modules, "個")$

/* モジュール配置（直並列） */
N_series : 10;  /* 直列数 */
N_parallel : float(ceil(N_modules / N_series));
print("直列数:", N_series, "直列")$
print("並列数:", N_parallel, "並列")$

/* 総出力電圧・電流 */
V_total : float(N_series * V_module);
I_total : float(N_parallel * I_module);
P_total : float(V_total * I_total);
print("総出力電圧:", float(V_total), "V")$
print("総出力電流:", float(I_total), "A")$
print("総出力:", float(P_total), "W")$

/* ---- 7. 熱電変換とスターリングエンジンの比較 ---- */
print("")$
print("=== 熱電変換 vs スターリングエンジン ===")$
print("方式, 効率(%), 信頼性, 重量, コスト, 総合評価")$

/* 熱電変換 */
eta_te : 12;  /* 熱電変換効率 12% */
print(concat("熱電変換(PbTe), ", eta_te, "%, 高, 軽, 中, 静音・無振動"))$

/* スターリング */
eta_stirling : 25;  /* スターリング効率 25% */
print(concat("スターリング, ", eta_stirling, "%, 中, 重, 高, 可動部あり"))$

/* ハイブリッド案 */
eta_hybrid : 18;  /* 熱電+スターリングハイブリッド */
print(concat("ハイブリッド, ", eta_hybrid, "%, 中, 中, 高, 冗長性あり"))$

/* ---- 8. 温度差変動の影響分析 ---- */
print("")$
print("=== 温度差変動の影響分析 ===")$
print("温度差(K), カルノー効率(%), PbTe効率(%), 出力比")$

for dT_var : 200 thru 400 step 25 do (
    T_hot_var : T_cold + dT_var,
    eta_c : float(1 - T_cold / T_hot_var),
    eta_pbte : float(dT_var / T_hot_var * (sqrt(1 + 1.2) - 1) / (sqrt(1 + 1.2) + T_cold / T_hot_var)),
    P_ratio_var : float(eta_pbte / (dT / T_hot * (sqrt(1 + 1.2) - 1) / (sqrt(1 + 1.2) + T_cold / T_hot))),
    print(concat(dT_var, ", ", float(eta_c * 100), ", ", float(eta_pbte * 100), ", ", float(P_ratio_var)))
)$

/* ---- 9. グラフ描画 ---- */
/* 材料別効率比較 */
mat_names : makelist(materials[i][1], i, 1, length(materials))$
mat_ZT : makelist(materials[i][2], i, 1, length(materials))$
mat_eta : makelist(
    float(dT / T_hot * (sqrt(1 + materials[i][2]) - 1) / (sqrt(1 + materials[i][2]) + T_cold / T_hot) * 100),
    i, 1, length(materials)
)$

/* データ点の作成 */
mat_data : makelist([i, mat_eta[i]], i, 1, length(materials))$

plot2d(
    [discrete, mat_data],
    [style, [points, 3, 1, 1], [impulses, 1, 1]],
    [legend, "最大効率(%)"],
    [xlabel, "材料"], [ylabel, "最大効率 (%)"],
    [xtics, 1, length(materials)],
    [title, "LENR-VENUS-007: 熱電変換材料の効率比較"],
    [gnuplot_preamble, concat("set xtics ('Bi2Te3' 1, 'PbTe' 2, 'Skutterudite' 3, 'SiGe' 4, 'Mg2Si' 5, 'Half-Heusler' 6, 'SnSe' 7, 'TAGS' 8) rotate by 45")]
)$

/* 温度差vs効率 */
dT_data : makelist([200 + i*25, float(1 - T_cold/(T_cold+200+i*25)) * 100], i, 0, 8)$
dT_data2 : makelist([200 + i*25, float((200+i*25)/(T_cold+200+i*25) * (sqrt(1+1.2)-1)/(sqrt(1+1.2)+T_cold/(T_cold+200+i*25)) * 100)], i, 0, 8)$

plot2d(
    [[discrete, dT_data], [discrete, dT_data2]],
    [style, [lines, 2, 1], [lines, 2, 2]],
    [legend, "カルノー効率", "PbTe効率"],
    [xlabel, "温度差 (K)"], [ylabel, "効率 (%)"],
    [title, "LENR-VENUS-007: 温度差 vs 効率"]
)$

/* ---- 10. 総合評価 ---- */
print("")$
print("=== 総合評価 ===")$
print("【最適材料】")$
print("  第1候補: PbTe (ZT=1.2, 効率約", float(dT/T_hot*(sqrt(1+1.2)-1)/(sqrt(1+1.2)+T_cold/T_hot)*100), "%)")$
print("  第2候補: Half-Heusler (ZT=1.1, 高強度)")$
print("  第3候補: TAGS (ZT=1.3, 高コスト)")$
print("")$
print("【最適化結果】")$
print("  最適負荷抵抗比 m_opt =", float(m_opt))$
print("  多段化効果: 2段で効率約1.5倍")$
print("")$
print("【推奨方式】")$
print("  熱電変換: 静音・無振動、信頼性高いが効率低い")$
print("  スターリング: 効率高いが可動部あり")$
print("  ハイブリッド: 両者の長所を活かす")$
print("")$
print("【結論】")$
print("  金星環境ではメンテナンスフリーの熱電変換が有望")$
print("  効率向上には多段化と新材料開発が鍵")$
print("  当面はPbTeモジュール", N_modules, "個で", float(P_total), "W出力可能")$
