/* ===== problem.mac ===== */
/* TAG: [PARAMS_LOAD] パラメータ読み込み */
load("stringproc")$
batch("params.txt")$

/* TAG: [ANALYTIC] 解析解の導出 */
wn: sqrt(k/m)$
zeta: c/(2*sqrt(m*k))$
discr: c^2 - 4*m*k$

/* TAG: [EXPORT_PYTHON] Python用出力（fortran形式） */
s: openw("analytic_core.py")$
printf(s, "# Auto-generated by Maxima~%")$
printf(s, "import numpy as np~%")$
printf(s, "from numpy import sqrt, exp, cos, sin~%~%")$
printf(s, "def get_wn_zeta(m, c, k):~%")$
printf(s, "    wn = sqrt(k/m)~%")$
printf(s, "    zeta = c/(2*sqrt(m*k))~%")$
printf(s, "    return float(wn), float(zeta)~%~%")$
printf(s, "def analytic_solution(t, m, c, k, x0, v0):~%")$
printf(s, "    wn = sqrt(k/m)~%")$
printf(s, "    zeta = c/(2*sqrt(m*k))~%")$
printf(s, "    if zeta < 1.0:~%")$
printf(s, "        wd = wn*sqrt(1 - zeta**2)~%")$
printf(s, "        A = x0~%")$
printf(s, "        B = (v0 + zeta*wn*x0)/wd~%")$
printf(s, "        return exp(-zeta*wn*t)*(A*cos(wd*t) + B*sin(wd*t))~%")$
printf(s, "    elif abs(zeta - 1.0) < 1e-8:~%")$
printf(s, "        A = x0~%")$
printf(s, "        B = v0 + wn*x0~%")$
printf(s, "        return (A + B*t)*exp(-wn*t)~%")$
printf(s, "    else:~%")$
printf(s, "        r1 = -wn*zeta + wn*sqrt(zeta**2 - 1)~%")$
printf(s, "        r2 = -wn*zeta - wn*sqrt(zeta**2 - 1)~%")$
printf(s, "        C2 = (v0 - r1*x0)/(r2 - r1)~%")$
printf(s, "        C1 = x0 - C2~%")$
printf(s, "        return C1*exp(r1*t) + C2*exp(r2*t)~%")$
close(s)$

/* TAG: [VERIFY] 結果の表示 */
print("Parameters loaded from params.txt")$
print("wn = ", float(wn))$
print("zeta = ", float(zeta))$
print("discriminant = ", float(discr))$
print("Done: analytic_core.py generated")$

