/* ============================================
   VF-AI-04-M2: 化学反応速度論計算
   ============================================
   
   課題仕様:
   ---------
   1. 目的:
      - 金星大気中の硫酸還元反応の反応速度をアレニウス式でモデル化
      - 触媒(Ni)存在下での反応速度定数(k)、活性化エネルギー(Ea)、反応時間を計算
      - 触媒効果を定量的に評価
   
   2. 対象反応:
      a) 硫酸熱分解（非触媒）:
         \[ \text{H}_2\text{SO}_4(l) \rightarrow \text{H}_2\text{O}(l) + \text{SO}_2(g) + \frac{1}{2}\text{O}_2(g) \]
      
      b) 水素還元（Ni触媒存在下）:
         \[ \text{H}_2\text{SO}_4(l) + 3\text{H}_2(g) \xrightarrow{\text{Ni}} 4\text{H}_2\text{O}(l) + \text{S}(s) \]
   
   3. 計算内容:
      - アレニウス式: \( k = A \exp\left(-\frac{E_a}{RT}\right) \)
      - 半減期計算: \( t_{1/2} = \frac{\ln(2)}{k} \) (一次反応仮定)
      - 遷移状態理論による検証: \( k_{\text{TST}} = \frac{k_B T}{h} \exp\left(-\frac{\Delta G^\ddagger}{RT}\right) \)
      - 触媒効果の定量評価: \( \text{増加率} = \frac{k_{\text{触媒}}}{k_{\text{非触媒}}} \)
   
   4. 出力:
      - 反応速度定数の温度依存性表
      - アレニウスプロットデータ \( \ln k \) vs \( 1/T \)
      - 触媒効果比較データ
      - グラフ画像（速度定数vs温度、ln(k)vs1/T）
      - 結果ファイル: VF_AI_04_M2_results.txt
   
   5. 連成情報:
      - 入力: なし（初回計算）
      - 出力: VF-AI-04-M3（全球化学収支シミュ）へ反応速度定数関数を引き渡し
         \[ k_1(T), k_2(T), E_{a1}, E_{a2} \]
   
   作成日: 2024年
   ============================================ */

/* 1. 物理定数定義 */
R: 8.314462618;      /* 気体定数 [J/(mol·K)] */
k_B: 1.380649e-23;   /* ボルツマン定数 [J/K] */
h: 6.62607015e-34;   /* プランク定数 [J·s] */
N_A: 6.02214076e23;  /* アボガドロ数 [1/mol] */

/* 2. アレニウス式パラメータ設定 */
/* 反応1: 硫酸熱分解（非触媒） */
A1: 1.0e13;          /* 頻度因子 [1/s] - 典型的な気相反応 */
Ea1: 180.0e3;        /* 活性化エネルギー [J/mol] (180 kJ/mol) */

/* 反応2: 水素還元（Ni触媒） */
A2: 5.0e10;          /* 頻度因子 [1/s] - 触媒反応 */
Ea2: 90.0e3;         /* 活性化エネルギー [J/mol] (90 kJ/mol) - 触媒で半減 */

/* 3. 反応速度定数計算関数定義 */
k1(T) := A1 * exp(-Ea1/(R*T));  /* 反応1の速度定数 */
k2(T) := A2 * exp(-Ea2/(R*T));  /* 反応2の速度定数 */

/* 4. 計算温度範囲設定: 金星環境温度 300K〜750K */
temperatures: [300, 350, 400, 450, 500, 550, 600, 650, 700, 750];

/* 5. 計算実行 - 反応速度定数表の生成 */
print("============================================");
print("VF-AI-04-M2: 金星硫酸還元反応 反応速度論計算");
print("============================================");

print("");
print("【反応1】硫酸熱分解（非触媒）: H2SO4 → H2O + SO2 + 1/2 O2");
print("温度[K]   速度定数 k[1/s]   半減期 t_1/2[s]   半減期[時間]");
print("----------------------------------------------------------");
for T in temperatures do (
  k_val: float(k1(T)),
  t_half: float(log(2)/k_val),      /* 一次反応の半減期 */
  t_half_hours: float(t_half/3600), /* 時間単位に変換 */
  print(sconcat(T, "     ", 
                float(k_val), "     ",
                float(t_half), "     ",
                float(t_half_hours)))
);

print("");
print("【反応2】水素還元（Ni触媒）: H2SO4 + 3H2 → 4H2O + S");
print("温度[K]   速度定数 k[1/s]   半減期 t_1/2[s]   半減期[秒]");
print("--------------------------------------------------------");
for T in temperatures do (
  k_val: float(k2(T)),
  t_half: float(log(2)/k_val),
  print(sconcat(T, "     ", 
                float(k_val), "     ",
                float(t_half), "     ",
                float(t_half)))
);

/* 6. アレニウスプロット用データ生成（ln(k) vs 1/T） */
print("");
print("【アレニウスプロットデータ】");
print("1/T [1/K]     ln(k1)反応1     ln(k2)反応2");
print("------------------------------------------");
for T in temperatures do (
  invT: float(1/T),
  lnk1: float(log(k1(T))),
  lnk2: float(log(k2(T))),
  print(sconcat(invT, "     ", lnk1, "     ", lnk2))
);

/* 7. 触媒効果の定量評価 */
print("");
print("【触媒効果の定量比較 (T=750K)】");
k1_750: float(k1(750));
k2_750: float(k2(750));
rate_enhancement: float(k2_750/k1_750);
print("反応1 (非触媒): k = ", k1_750, " 1/s");
print("反応2 (Ni触媒): k = ", k2_750, " 1/s");
print("速度増加率 = ", rate_enhancement, " 倍");
print("活性化エネルギー低下量 = ", float((Ea1 - Ea2)/1000), " kJ/mol");

/* 8. 実用的反応時間計算（99%反応完了までの時間） */
print("");
print("【99%反応完了までの時間】");
print("温度[K]   反応1[年]   反応2[秒]");
print("------------------------------");
for T in [500, 600, 700, 750] do (
  /* 一次反応速度式: ln(C0/C) = kt, 99%完了なら C/C0 = 0.01 */
  t99_1: float(-log(0.01)/k1(T)),  /* 反応1の時間 [秒] */
  t99_2: float(-log(0.01)/k2(T)),  /* 反応2の時間 [秒] */
  t99_1_years: float(t99_1/(365.25*24*3600)), /* 年単位に変換 */
  print(sconcat(T, "     ", 
                float(t99_1_years), "     ",
                float(t99_2)))
);

/* 9. 遷移状態理論による速度定数検証 */
print("");
print("【遷移状態理論による検証】");
print("温度[K]   k_TST[1/s]   k_Arrhenius[1/s]   比(k_TST/k_Arr)");
print("--------------------------------------------------------");

/* 遷移状態理論パラメータ設定 */
deltaH1: 175.0e3;  /* 反応1の活性化エンタルピー [J/mol] */
deltaS1: -50.0;    /* 反応1の活性化エントロピー [J/(mol·K)] */
deltaH2: 85.0e3;   /* 反応2の活性化エンタルピー [J/mol] */
deltaS2: -80.0;    /* 反応2の活性化エントロピー [J/(mol·K)] */

for T in [500, 600, 700] do (
  /* 遷移状態理論による速度定数計算 */
  k_TST1: float((k_B*T/h) * exp(-(deltaH1 - T*deltaS1)/(R*T)) * N_A),
  k_TST2: float((k_B*T/h) * exp(-(deltaH2 - T*deltaS2)/(R*T)) * N_A),
  
  /* アレニウス式による速度定数 */
  k_Arr1: float(k1(T)),
  k_Arr2: float(k2(T)),
  
  /* 両者の比較 */
  ratio1: float(k_TST1/k_Arr1),
  ratio2: float(k_TST2/k_Arr2),
  
  print(sconcat(T, "     ",
                float(k_TST1), "     ",
                float(k_Arr1), "     ",
                float(ratio1))),
  print(sconcat("        ", 
                float(k_TST2), "     ",
                float(k_Arr2), "     ",
                float(ratio2)))
);

/* 10. グラフプロット */
load("draw");

/* グラフ1: 反応速度定数の温度依存性 */
draw2d(
  title = "硫酸還元反応の速度定数温度依存性",
  xlabel = "温度 [K]",
  ylabel = "速度定数 k [1/s]",
  xrange = [300, 800],
  yrange = [1e-20, 1e2],
  logy = true,
  grid = true,
  key = "反応1: 熱分解 (非触媒)",
  explicit(k1(T), T, 300, 800),
  color = red,
  key = "反応2: 水素還元 (Ni触媒)",
  explicit(k2(T), T, 300, 800),
  color = blue,
  user_preamble = "set logscale y"
);

/* グラフ2: アレニウスプロット */
draw2d(
  title = "アレニウスプロット (ln k vs 1/T)",
  xlabel = "1/T [1/K]",
  ylabel = "ln(k)",
  xrange = [0.00125, 0.00333],  /* 300K〜800Kに対応 */
  grid = true,
  key = "反応1: 熱分解",
  explicit(log(k1(1/x)), x, 0.00125, 0.00333),
  color = red,
  key = "反応2: 水素還元",
  explicit(log(k2(1/x)), x, 0.00125, 0.00333),
  color = blue
);

/* 11. 結果ファイル出力 */
with_stdout("VF_AI_04_M2_results.txt",
  print("VF-AI-04-M2 計算結果: 反応速度論"),
  print("================================="),
  print(""),
  print("【反応概要】"),
  print("反応1: H2SO4 → H2O + SO2 + 1/2 O2 (非触媒)"),
  print("反応2: H2SO4 + 3H2 → 4H2O + S (Ni触媒)"),
  print(""),
  print("【アレニウスパラメータ】"),
  print("反応1: A = ", A1, " 1/s, Ea = ", Ea1/1000, " kJ/mol"),
  print("反応2: A = ", A2, " 1/s, Ea = ", Ea2/1000, " kJ/mol"),
  print(""),
  print("【反応速度定数】"),
  print("温度[K]   反応1 k[1/s]   反応2 k[1/s]"),
  for T in temperatures do (
    k1_val: float(k1(T)),
    k2_val: float(k2(T)),
    print(sconcat(T, "     ", k1_val, "     ", k2_val))
  ),
  print(""),
  print("【実用的反応時間 (99%完了)】"),
  for T in [500, 600, 700, 750] do (
    t99_1: float(-log(0.01)/k1(T)),
    t99_2: float(-log(0.01)/k2(T)),
    t99_1_years: float(t99_1/(365.25*24*3600)),
    print(sconcat("T=", T, "K: 反応1=", t99_1_years, "年, 反応2=", t99_2, "秒"))
  ),
  print(""),
  print("【次のモジュールへの引き渡し情報】"),
  print("VF-AI-04-M3 (全球化学収支シミュ) へ以下を引き渡し:"),
  print("1. 反応速度定数関数: k1(T), k2(T)"),
  print("2. 活性化エネルギー: Ea1 = ", Ea1/1000, " kJ/mol, Ea2 = ", Ea2/1000, " kJ/mol"),
  print("3. 触媒効果: 速度増加率 = ", rate_enhancement, "倍")
);

print("");
print("✅ VF-AI-04-M2 計算完了！");
print("結果を VF_AI_04_M2_results.txt に保存しました。");

/* 12. 次のモジュールへのバトン情報 */
print("");
print("============================================");
print("【次のステップ: VF-AI-04-M3】");
print("モジュール名: 全球化学収支シミュレーション");
print("必要な入力データ:");
print("1. 反応速度定数関数: k1(T), k2(T)");
print("2. 金星大気中の硫酸濃度初期値: [H2SO4]_0");
print("3. 水素供給速度: v_H2 [mol/s]");
print("4. 金星大気温度プロファイル: T(z)");
print("============================================");

