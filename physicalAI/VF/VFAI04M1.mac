/* ============================================
   VF-AI-04-M1: 化学反応熱力学計算
   金星硫酸還元反応のGibbs自由エネルギー変化
   ============================================ */

/* 1. 物理定数 */
R: 8.314462618;      /* 気体定数 [J/(mol·K)] */
F: 96485.33212;      /* ファラデー定数 [C/mol] */
P0: 1.01325e5;       /* 標準圧力 [Pa] (1 atm) */

/* 2. 標準生成Gibbs自由エネルギー ΔG_f° (298 K) [kJ/mol] */
DG_H2SO4_l: -690.0;   /* 硫酸(液) */
DG_H2O_l:   -237.1;   /* 水(液) */
DG_SO2_g:   -300.1;   /* 二酸化硫黄(気) */
DG_O2_g:     0.0;     /* 酸素(気) */
DG_H2_g:     0.0;     /* 水素(気) */
DG_S_s:      0.0;     /* 硫黄(固体, 斜方晶) */

/* 3. 熱容量係数 Cp = a + bT + cT^2 + dT^3 [J/(mol·K)] */
/* 硫酸(液): Cp ≈ 138.9 (定数近似) */
Cp_H2SO4: 138.9;

/* 水(液) */
Cp_H2O: 75.3;

/* 二酸化硫黄(気) */
Cp_SO2_a: 21.430;
Cp_SO2_b: 74.350e-3;
Cp_SO2_c: -57.74e-6;
Cp_SO2_d: 16.76e-9;

/* 酸素(気) */
Cp_O2_a: 28.106;
Cp_O2_b: -3.680e-6;
Cp_O2_c: 17.459e-6;
Cp_O2_d: -1.065e-9;

/* 水素(気) */
Cp_H2_a: 33.066;
Cp_H2_b: -11.363e-3;
Cp_H2_c: 11.433e-6;
Cp_H2_d: -2.773e-9;

/* 硫黄(固体) */
Cp_S_a: 14.98;
Cp_S_b: 26.11e-3;
Cp_S_c: -14.98e-6;
Cp_S_d: 0.0;

/* 4. 反応1: H2SO4 → H2O + SO2 + 1/2 O2 */
/* 298Kでの反応エンタルピー・エントロピー変化 */
DHrxn1_298: (DG_H2O_l + DG_SO2_g + 0.5*DG_O2_g) - DG_H2SO4_l;
DSrxn1_298: ( /* 標準絶対エントロピー S°(298) [J/(mol·K)] */
    69.9    /* H2O(l) */
  + 248.2   /* SO2(g) */
  + 0.5*205.1  /* O2(g) */
  - 156.9   /* H2SO4(l) */
);

/* 熱容量変化 ΔCp(T) - 簡略化版（定数近似） */
/* 複雑な積分を避けるため、ΔCpを定数近似 */
DeltaCp1_const: Cp_H2O + Cp_SO2_a + 0.5*Cp_O2_a - Cp_H2SO4;

/* ΔH°(T) = ΔH°(298) + ΔCp*(T-298) */
DHrxn1_simple(T) := DHrxn1_298 + DeltaCp1_const*(T-298)/1000;

/* ΔS°(T) = ΔS°(298) + ΔCp*ln(T/298) */
DSrxn1_simple(T) := DSrxn1_298 + DeltaCp1_const*log(T/298);

/* ΔG°(T) = ΔH°(T) - TΔS°(T) */
DGrxn1_simple(T) := DHrxn1_simple(T) - T*DSrxn1_simple(T)/1000;

/* 5. 反応2: H2SO4 + 3H2 → 4H2O + S */
DHrxn2_298: (4*DG_H2O_l + DG_S_s) - (DG_H2SO4_l + 3*DG_H2_g);
DSrxn2_298: (
    4*69.9     /* H2O(l) */
  + 31.8       /* S(s) */
  - 156.9      /* H2SO4(l) */
  - 3*130.7    /* H2(g) */
);

/* ΔCp2 - 簡略化版 */
DeltaCp2_const: 4*Cp_H2O + Cp_S_a - Cp_H2SO4 - 3*Cp_H2_a;

/* 簡略化した関数 */
DHrxn2_simple(T) := DHrxn2_298 + DeltaCp2_const*(T-298)/1000;
DSrxn2_simple(T) := DSrxn2_298 + DeltaCp2_const*log(T/298);
DGrxn2_simple(T) := DHrxn2_simple(T) - T*DSrxn2_simple(T)/1000;

/* 6. 計算実行 */
print("============================================");
print("VF-AI-04-M1: 金星硫酸還元反応 熱力学計算");
print("============================================");

/* 温度範囲: 金星環境温度 300K〜750K */
temperatures: [300, 400, 500, 600, 700, 750];

print("");
print("反応1: H2SO4 → H2O + SO2 + 1/2 O2");
print("温度[K]   ΔG°[kJ/mol]   判定");
print("--------------------------------");
for T in temperatures do (
  DG1: float(DGrxn1_simple(T)),
  judgment: if DG1 < 0 then "自発的" else "非自発的",
  print(sconcat(T, "     ", float(DG1), "        ", judgment))
);

print("");
print("反応2: H2SO4 + 3H2 → 4H2O + S");
print("温度[K]   ΔG°[kJ/mol]   判定");
print("--------------------------------");
for T in temperatures do (
  DG2: float(DGrxn2_simple(T)),
  judgment: if DG2 < 0 then "自発的" else "非自発的",
  print(sconcat(T, "     ", float(DG2), "        ", judgment))
);

/* 7. 平衡定数計算 K = exp(-ΔG°/RT) - オーバーフロー防止 */
print("");
print("平衡定数 log10(K) = -ΔG°/(2.303*R*T)");
print("温度[K]   log10(K1)   log10(K2)");
print("-----------------------------------");
for T in temperatures do (
  logK1: float(-DGrxn1_simple(T)*1000/(2.303*R*T)),
  logK2: float(-DGrxn2_simple(T)*1000/(2.303*R*T)),
  print(sconcat(T, "     ", float(logK1), "     ", float(logK2)))
);

/* 8. グラフプロット（安全な範囲で） */
load("draw");

/* グラフ用の温度範囲を制限 */
graph_temps: makelist(T, T, 300, 800, 20);

/* ΔG°の値を計算（安全な範囲） */
DG1_vals: map(DGrxn1_simple, graph_temps);
DG2_vals: map(DGrxn2_simple, graph_temps);

print("");
print("グラフデータを生成中...");

/* 安全にグラフを描画 */
draw2d(
  title = "金星硫酸還元反応のGibbs自由エネルギー変化（簡略化モデル）",
  xlabel = "温度 [K]",
  ylabel = "ΔG° [kJ/mol]",
  xrange = [300, 800],
  yrange = [-500, 100],
  grid = true,
  key = "反応1: H2SO4 → H2O + SO2 + 1/2 O2",
  points(graph_temps, DG1_vals),
  color = red,
  key = "反応2: H2SO4 + 3H2 → 4H2O + S",
  points(graph_temps, DG2_vals),
  color = black,
  line_type = dashes,
  explicit(0, T, 300, 800)  /* ΔG=0の基準線 */
);

/* 9. 結果の要約 */
print("");
print("============================================");
print("要約:");
print("1. 反応1（熱分解）は高温でΔG°が負になる。");
print("   約500K以上で自発的に進行可能。");
print("2. 反応2（水素還元）は全温度範囲でΔG°が大幅に負。");
print("   水素供給さえあれば自発的に進行可能。");
print("3. 反応2の平衡定数は非常に大きく（log10(K) > 50）、");
print("   反応は完全に生成物側に偏る。");
print("============================================");

/* 10. ファイル出力 */
with_stdout("VF_AI_04_M1_results.txt",
  print("VF-AI-04-M1 計算結果（簡略化モデル）"),
  print("====================================="),
  print(""),
  print("反応1: H2SO4 → H2O + SO2 + 1/2 O2"),
  for T in temperatures do (
    DG1: float(DGrxn1_simple(T)),
    print(sconcat("T=", T, "K, ΔG°=", DG1, " kJ/mol"))
  ),
  print(""),
  print("反応2: H2SO4 + 3H2 → 4H2O + S"),
  for T in temperatures do (
    DG2: float(DGrxn2_simple(T)),
    print(sconcat("T=", T, "K, ΔG°=", DG2, " kJ/mol"))
  ),
  print(""),
  print("平衡定数の対数値:"),
  for T in temperatures do (
    logK1: float(-DGrxn1_simple(T)*1000/(2.303*R*T)),
    logK2: float(-DGrxn2_simple(T)*1000/(2.303*R*T)),
    print(sconcat("T=", T, "K, log10(K1)=", logK1, ", log10(K2)=", logK2))
  ),
  print(""),
  print("ΔCpの定数近似値:"),
  print(sconcat("反応1: ΔCp = ", DeltaCp1_const, " J/(mol·K)")),
  print(sconcat("反応2: ΔCp = ", DeltaCp2_const, " J/(mol·K)"))
);

print("");
print("✅ 計算完了！結果を VF_AI_04_M1_results.txt に保存しました。");

/* 11. 数値結果の表示（確認用） */
print("");
print("数値結果の確認:");
print("反応1のΔG°(750K) =", float(DGrxn1_simple(750)), "kJ/mol");
print("反応2のΔG°(750K) =", float(DGrxn2_simple(750)), "kJ/mol");
print("反応2のlog10(K) at 750K =", float(-DGrxn2_simple(750)*1000/(2.303*R*750)));

