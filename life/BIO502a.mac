/* ============================================================ */
/* BIO-502: Organ Replacement                                    */
/* Xenogeneic Organ Rejection Probability                        */
/* 豚臓器の免疫拒絶確率、免疫抑制剤最適化                          */
/*                                                              */
/* 【仕様】                                                      */
/* 1. 免疫拒絶モデル                                              */
/*    時間経過に伴う拒絶反応確率 P_reject(t)                       */
/*    P_reject(t) = 1 - exp(-lambda * t)                         */
/*    lambda: 免疫抑制剤依存の拒絶率                              */
/*                                                              */
/* 2. 免疫抑制剤最適化                                            */
/*    拒絶予防と副作用のトレードオフ                                */
/*    最適化: Cost = w1*P_reject + w2*SideEffect を最小化        */
/*                                                              */
/* 3. パラメータ                                                 */
/*    base_rejection_rate: 0.1 (抑制なし)                        */
/*    drug_efficacy: 0.8 (最大抑制効果)                          */
/*    side_effect_rate: 0.05 (単位用量あたり)                    */
/*    t_max: 365日 (移植後1年)                                   */
/*                                                              */
/* 4. グラフ描画                                                 */
/*    draw2dで4つのグラフを表示                                   */
/* ============================================================ */

display2d:false;
load(draw)$

base_rejection_rate: 0.1$
drug_efficacy: 0.8$
side_effect_rate: 0.05$
t_max: 365$
w1: 0.6$
w2: 0.4$

print("==========================================")$
print("BIO-502: 異種臓器拒絶反応確率")$
print("==========================================")$

print("パラメータ:")$
print("  基本拒絶率 = ", base_rejection_rate, " /日")$
print("  薬剤効果 = ", drug_efficacy)$
print("  副作用率 = ", side_effect_rate, " /単位用量")$

P_reject_no_drug(t) := 1 - exp(-base_rejection_rate * t)$
lambda_eff(d) := base_rejection_rate * (1 - drug_efficacy * d)$
P_reject(t, d) := 1 - exp(-lambda_eff(d) * t)$
P_side_effect(d) := 1 - exp(-side_effect_rate * d * t_max / 30)$
total_cost(d) := w1 * P_reject(t_max, d) + w2 * P_side_effect(d)$

print("")$
print("=== 各用量での拒絶確率 (1年後) ===")$
print("用量      拒絶確率  副作用確率  総コスト")$
for i:0 thru 10 do (
    d_val: i/10,
    pr: float(P_reject(t_max, d_val)),
    ps: float(P_side_effect(d_val)),
    tc: float(total_cost(d_val)),
    print(d_val, "  ", pr, "  ", ps, "  ", tc)
)$

/* 最適用量計算（ループで探索） */
optimal_dose: 0$
min_cost: 1.0$
for i:0 thru 100 do (
    d_val: i/100,
    tc: float(total_cost(d_val)),
    if tc < min_cost then (
        min_cost: tc,
        optimal_dose: d_val
    )
)$
print("")$
print("=== 最適免疫抑制剤用量 ===")$
print("最適用量 = ", optimal_dose)$
print("最小総コスト = ", min_cost)$
print("最適用量での拒絶確率 = ", float(P_reject(t_max, optimal_dose)))$
print("最適用量での副作用確率 = ", float(P_side_effect(optimal_dose)))$

print("")$
print("=== 拒絶確率の時間経過 ===")$
print("日数      薬なし    最適用量  最大用量")$
for day:0 thru 365 step 30 do (
    pr0: float(P_reject_no_drug(day)),
    pr_opt: float(P_reject(day, optimal_dose)),
    pr_max: float(P_reject(day, 1.0)),
    print(day, "  ", pr0, "  ", pr_opt, "  ", pr_max)
)$

/* グラフ1: 拒絶確率の時間変化 */
draw2d(
    title = "図1: 拒絶確率の時間変化",
    xlabel = "移植後日数", ylabel = "拒絶確率",
    key = "薬なし",
    explicit(P_reject_no_drug(t), t, 0, 365),
    color = red, line_width = 2,
    key = "最適用量",
    explicit(P_reject(t, optimal_dose), t, 0, 365),
    color = blue, line_width = 2,
    key = "最大用量",
    explicit(P_reject(t, 1.0), t, 0, 365),
    color = green, line_width = 2,
    grid = true
)$

/* グラフ2: 用量反応曲線 */
draw2d(
    title = "図2: 用量反応曲線 (1年後)",
    xlabel = "免疫抑制剤用量", ylabel = "確率",
    key = "拒絶確率",
    explicit(P_reject(t_max, d), d, 0, 1),
    color = red, line_width = 2,
    key = "副作用確率",
    explicit(P_side_effect(d), d, 0, 1),
    color = orange, line_width = 2,
    key = "総コスト",
    explicit(total_cost(d), d, 0, 1),
    color = purple, line_width = 2,
    grid = true
)$

/* グラフ3: 重み係数と最適用量の関係（離散点で計算） */
w1_list: makelist(i/10, i, 1, 9)$
d_opt_list: makelist(block([w1v: w1_list[i], w2v: 1-w1_list[i], minc: 1.0, dopt: 0],
    for j:0 thru 100 do (
        dv: j/100,
        tcv: w1v * (1 - exp(-base_rejection_rate*(1-drug_efficacy*dv)*t_max)) + w2v * (1 - exp(-side_effect_rate*dv*t_max/30)),
        if tcv < minc then (minc: tcv, dopt: dv)
    ),
    dopt
), i, 1, 9)$

draw2d(
    title = "図3: 拒絶重視度と最適用量",
    xlabel = "拒絶反応の重み w1", ylabel = "最適用量",
    key = "最適用量",
    points(w1_list, d_opt_list),
    color = blue, line_width = 2,
    grid = true
)$

/* グラフ4: 基本拒絶率と最適用量の関係（離散点で計算） */
br_list: makelist(i/100, i, 2, 20)$
d_opt_br_list: makelist(block([br: br_list[i], minc: 1.0, dopt: 0],
    for j:0 thru 100 do (
        dv: j/100,
        tcv: w1 * (1 - exp(-br*(1-drug_efficacy*dv)*t_max)) + w2 * (1 - exp(-side_effect_rate*dv*t_max/30)),
        if tcv < minc then (minc: tcv, dopt: dv)
    ),
    dopt
), i, 1, 19)$

draw2d(
    title = "図4: 基本拒絶率と最適用量",
    xlabel = "基本拒絶率", ylabel = "最適用量",
    key = "最適用量",
    points(br_list, d_opt_br_list),
    color = green, line_width = 2,
    grid = true
)$

print("")$
print("全4グラフを表示しました")$
print("==========================================")$
print("BIO-502 analysis complete")$
print("==========================================")$
