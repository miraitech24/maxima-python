/* ============================================================ */
/* BIO-506: Metabolic Modification                              */
/* Photosynthesis-Traditional Metabolism Integration Rate       */
/* 光合成と従来代謝のエネルギー配分最適化                        */
/*                                                              */
/* 【仕様】                                                      */
/* 1. エネルギー配分モデル                                       */
/*    E_total = E_photo + E_conv                                 */
/*    E_photo: 光合成由来エネルギー                              */
/*    E_conv: 従来代謝由来エネルギー                             */
/*    f: 光合成への配分比率 (0-1)                                */
/*                                                              */
/* 2. 最適化問題                                                 */
/*    総エネルギー効率最大化:                                    */
/*    max E_total(f) = E_photo_max * f + E_req * (1-f)          */
/*    subject to: 0 <= f <= 1                                    */
/*                                                              */
/* 3. パラメータ                                                 */
/*    eta_photo: 光合成効率 = 0.10 (10%)                        */
/*    eta_conv: 従来代謝効率 = 0.25 (25%)                       */
/*    E_req: 必要エネルギー = 2000 kcal/day = 8368000 J        */
/*    solar_flux: 太陽光フラックス = 500 W/m2                    */
/*    body_area: 体表面積 = 1.8 m2                               */
/*    sunlight_hours: 日照時間 = 8 h/day                         */
/*                                                              */
/* 4. グラフ描画                                                 */
/*    draw2dで4つのグラフをPNG出力                                */
/* ============================================================ */

display2d:false;
load(draw)$

/* パラメータ定義 */
eta_photo: 0.10$
eta_conv: 0.25$
E_req: 2000 * 4184$
solar_flux: 500$
body_area: 1.8$
sunlight_hours: 8$

print("==========================================")$
print("BIO-506: Photosynthesis-Metabolism Integration")$
print("==========================================")$

E_solar_daily: solar_flux * body_area * sunlight_hours * 3600$
E_photo_max: E_solar_daily * eta_photo$
print("1日あたり太陽エネルギー: ", E_solar_daily, " J")$
print("光合成最大生産エネルギー: ", E_photo_max, " J")$
print("必要エネルギー: ", E_req, " J")$

optimal_f: eta_photo / (eta_photo + eta_conv)$
print("最適光合成配分率 f_opt = ", float(optimal_f))$

E_total(f) := E_photo_max * f + E_req * (1 - f)$
E_opt: E_total(optimal_f)$
print("最適時の総エネルギー: ", float(E_opt), " J")$
print("充足率: ", float(E_opt / E_req * 100), " %")$

print("")$
print("=== 配分率とエネルギー収支 ===")$
print("f         E_photo    E_conv    E_total   Sufficiency")$
for i:0 thru 10 do (
    f_val: i/10,
    ep: E_photo_max * f_val,
    ec: E_req * (1 - f_val),
    et: ep + ec,
    suff: et / E_req * 100,
    print(float(f_val), "  ", float(ep), "  ", float(ec), "  ", float(et), "  ", float(suff), "%")
)$

print("")$
print("=== 光合成効率と最適配分率 ===")$
print("eta_photo  f_opt      E_total    Sufficiency")$
for ep_val in [0.05, 0.10, 0.15, 0.20, 0.25, 0.30] do (
    f_opt: ep_val / (ep_val + eta_conv),
    E_opt_val: E_solar_daily * ep_val * f_opt + E_req * (1 - f_opt),
    print(float(ep_val), "  ", float(f_opt), "  ", float(E_opt_val), "  ", float(E_opt_val/E_req*100), "%")
)$

/* グラフ1: 配分率 vs エネルギー収支 */
draw2d(
    file_name = "BIO506_fig1_energy_balance",
    terminal = png,
    title = "Fig.1: Energy Balance vs Allocation Ratio",
    xlabel = "Photosynthesis Allocation Ratio f",
    ylabel = "Energy (J/day)",
    key = "E_photo",
    explicit(E_photo_max * f, f, 0, 1),
    color = red,
    key = "E_conv",
    explicit(E_req * (1 - f), f, 0, 1),
    color = blue,
    key = "E_total",
    explicit(E_photo_max * f + E_req * (1 - f), f, 0, 1),
    color = green,
    line_width = 2,
    grid = true
)$

/* グラフ2: 配分率 vs エネルギー充足率 */
draw2d(
    file_name = "BIO506_fig2_sufficiency",
    terminal = png,
    title = "Fig.2: Energy Sufficiency vs Allocation Ratio",
    xlabel = "Photosynthesis Allocation Ratio f",
    ylabel = "Energy Sufficiency (%)",
    key = "Sufficiency",
    explicit((E_photo_max * f + E_req * (1 - f)) / E_req * 100, f, 0, 1),
    color = blue,
    line_width = 2,
    grid = true
)$

/* グラフ3: 光合成効率 vs 最適配分率 */
draw2d(
    file_name = "BIO506_fig3_optimal_allocation",
    terminal = png,
    title = "Fig.3: Optimal Allocation vs Photosynthesis Efficiency",
    xlabel = "Photosynthesis Efficiency eta_photo",
    ylabel = "Optimal Allocation Ratio f_opt",
    key = "f_opt",
    explicit(x / (x + eta_conv), x, 0.05, 0.30),
    color = red,
    line_width = 2,
    grid = true
)$

/* グラフ4: 光合成効率 vs 最大充足率 */
draw2d(
    file_name = "BIO506_fig4_max_sufficiency",
    terminal = png,
    title = "Fig.4: Max Sufficiency vs Photosynthesis Efficiency",
    xlabel = "Photosynthesis Efficiency eta_photo",
    ylabel = "Max Energy Sufficiency (%)",
    key = "Max Sufficiency",
    explicit((E_solar_daily * x * (x/(x+eta_conv)) + E_req * (1 - x/(x+eta_conv))) / E_req * 100, x, 0.05, 0.30),
    color = green,
    line_width = 2,
    grid = true
)$

print("")$
print("全4グラフを出力しました")$
print("ファイル: BIO506_fig1_energy_balance.png")$
print("ファイル: BIO506_fig2_sufficiency.png")$
print("ファイル: BIO506_fig3_optimal_allocation.png")$
print("ファイル: BIO506_fig4_max_sufficiency.png")$
print("==========================================")$
print("BIO-506 analysis complete")$
print("==========================================")$
