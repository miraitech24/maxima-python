/* BIO-533: Limb Regeneration Probability Analysis */
display2d:false;

P_wound: 0.95$
P_blastema: 0.8$
P_proliferation: 0.75$
P_differentiation: 0.7$
P_morphogenesis: 0.65$

P_total: P_wound * P_blastema * P_proliferation * P_differentiation * P_morphogenesis;
print("Lizard total probability:", float(P_total))$

human_factor: 0.3$
P_human: P_total * human_factor;
print("Human base probability:", float(P_human))$

age_effect(age) := exp(-0.02 * age)$
size_effect(size) := exp(-0.5 * size)$

final_prob(P_base, age, size, intervention) := 
    P_base * age_effect(age) * size_effect(size) * (1 + intervention)$

for age in [0, 20, 40, 60, 80] do (
    prob: float(final_prob(P_human, age, 0.5, 0.6)),
    print("Age", age, ":", prob*100, "%")
)$

print("BIO-533 analysis complete")$
