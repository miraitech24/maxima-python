/* 
===============================================
BIO-501: 脳-機械インターフェース生着率 計算プログラム (修正版)
===============================================
*/

kill(all)$

/* 1. 神経工学的パラメータ */
electrode_material: "グラフェン";
electrode_diameter: 0.000005;
electrode_count: 1000;
implantation_depth: 0.002;

/* 2. 生物学的パラメータ */
neuron_density: 80000;
glial_cell_density: 200000;
blood_brain_barrier: 1;

/* 3. 生体反応パラメータ */
inflammation_response: 0.3;
scar_tissue_formation: 0.2;
immune_rejection: 0.1;

/* 4. 信号伝達パラメータ */
signal_to_noise_ratio: 20;
signal_stability: 0.85;
long_term_stability: 0.7;

/* 5. 時間パラメータ */
implantation_time: 0;
monitoring_period: 365;

/* 物理定数 */
k_B: 1.380649e-23;
T: 310.15;

/* 関数定義: 電極-ニューロン接触確率 */
electrode_neuron_contact_probability(electrode_dia, neuron_dens, depth) := block(
    [contact_volume, expected_neurons, contact_prob],
    
    contact_volume: %pi * (electrode_dia/2)^2 * depth,
    expected_neurons: neuron_dens * contact_volume * 1e9,
    contact_prob: 1 - exp(-expected_neurons),
    
    contact_prob
);

/* 関数定義: 生体適合性確率 */
biocompatibility_probability(inflammation, scar, rejection) := block(
    [prob],
    
    prob: (1 - inflammation) * (1 - scar) * (1 - rejection),
    
    prob
);

/* 関数定義: 信号伝達効率 */
signal_transmission_efficiency(snr, stability, long_term) := block(
    [efficiency, snr_factor],
    
    snr_factor: 1 - exp(-snr/10),
    efficiency: snr_factor * stability * long_term,
    
    efficiency
);

/* 関数定義: 長期生着確率 */
long_term_integration_probability(initial_prob, time_days) := block(
    [degradation_rate, prob],
    
    degradation_rate: 0.999,
    prob: initial_prob * degradation_rate^time_days,
    
    prob
);

/* 関数定義: 二項分布CDF (簡易版) */
binomial_cdf_simple(k, n, p) := block(
    [sum_prob, i],
    
    sum_prob: 0,
    for i:0 thru k do (
        sum_prob: sum_prob + binomial(n, i) * p^i * (1-p)^(n-i)
    ),
    
    sum_prob
);

/* 関数定義: 総合生着成功率 */
total_integration_success() := block(
    [P_contact, P_biocompat, P_signal, P_longterm, P_total, single_success,
     results],
    
    /* 1. 接触確率 */
    P_contact: electrode_neuron_contact_probability(electrode_diameter, 
                                                   neuron_density, 
                                                   implantation_depth),
    
    /* 2. 生体適合性確率 */
    P_biocompat: biocompatibility_probability(inflammation_response,
                                             scar_tissue_formation,
                                             immune_rejection),
    
    /* 3. 信号伝達効率 */
    P_signal: signal_transmission_efficiency(signal_to_noise_ratio,
                                           signal_stability,
                                           long_term_stability),
    
    /* 4. 長期安定性 */
    P_longterm: long_term_integration_probability(P_biocompat * P_signal,
                                                 monitoring_period),
    
    /* 単一電極成功確率 */
    single_success: P_contact * P_longterm,
    
    /* 5. 総合確率 (少なくとも1電極が機能) */
    P_total: 1 - (1 - single_success)^electrode_count,
    
    /* 結果の整理 */
    results: [
        ["Electrode_neuron_contact_probability", P_contact],
        ["Biocompatibility_probability", P_biocompat],
        ["Signal_transmission_efficiency", P_signal],
        ["Long_term_integration_probability", P_longterm],
        ["Single_electrode_success", single_success],
        ["Total_integration_success", P_total],
        ["Effective_electrodes", electrode_count * single_success]
    ],
    
    results
);

/* メイン計算 */
print("================================================")$
print("BIO-501: Brain-Machine Interface Integration")$
print("================================================")$
print("")$

print("1. System Parameters:")$
print("  Electrode material:", electrode_material)$
print("  Electrode diameter:", electrode_diameter*1e6, "μm")$
print("  Number of electrodes:", electrode_count)$
print("  Implantation depth:", implantation_depth*1000, "mm")$
print("")$

/* 総合成功率計算 */
results: total_integration_success()$
P_total: 0$
single_success: 0$
for result in results do (
    if result[1] = "Total_integration_success" then P_total: result[2],
    if result[1] = "Single_electrode_success" then single_success: result[2]
)$

print("2. Integration Probability Analysis:")$
print("  ----------------------------------")$
for result in results do (
    if member(result[1], ["Total_integration_success", "Single_electrode_success"]) then
        printf(true, "  ~35a: ~8,3f (~5,1f%)~%", result[1], result[2], result[2]*100)
    else
        printf(true, "  ~35a: ~8,3f~%", result[1], result[2])
)$
print("")$

/* 材料別比較 */
print("3. Material Comparison:")$
print("  ---------------------")$
materials: [
    ["Graphene", 0.95, 0.90],
    ["Iridium oxide", 0.85, 0.80],
    ["Platinum", 0.80, 0.75],
    ["Tungsten", 0.70, 0.65]
]$

for material in materials do (
    material_name: material[1],
    bio_compat: material[2],
    signal_eff: material[3],
    
    /* 生体適合性を更新 */
    inflammation_response_temp: 0.3 * (1 - bio_compat),
    signal_stability_temp: signal_eff,
    
    /* 一時的にパラメータを変更して計算 */
    inflammation_response_save: inflammation_response,
    signal_stability_save: signal_stability,
    
    inflammation_response: inflammation_response_temp,
    signal_stability: signal_stability_temp,
    
    results_mat: total_integration_success(),
    P_mat: 0,
    for r in results_mat do if r[1] = "Total_integration_success" then P_mat: r[2],
    
    printf(true, "  ~15a: ~6,3f (~5,1f%)~%", material_name, P_mat, P_mat*100),
    
    /* 元の値に戻す */
    inflammation_response: inflammation_response_save,
    signal_stability: signal_stability_save
)$
print("")$

/* 電極数最適化 */
print("4. Electrode Count Optimization:")$
print("  ------------------------------")$
electrode_counts: [100, 500, 1000, 5000, 10000]$
electrode_count_save: electrode_count$

for count in electrode_counts do (
    electrode_count: count,
    results_count: total_integration_success(),
    P_count: 0,
    for r in results_count do if r[1] = "Total_integration_success" then P_count: r[2],
    
    printf(true, "  ~6d electrodes: P = ~6,3f~%", count, P_count)
)$

electrode_count: electrode_count_save$
print("")$

/* 臨床的閾値分析 (エラー修正版) */
print("5. Clinical Threshold Analysis:")$
print("  -----------------------------")$
thresholds: [
    ["Minimal functional (10 electrodes)", 10],
    ["Basic control (100 electrodes)", 100],
    ["Advanced control (1000 electrodes)", 1000],
    ["Full immersion (10000 electrodes)", 10000]
]$

for threshold in thresholds do (
    threshold_name: threshold[1],
    required_electrodes: threshold[2],
    
    /* 二項分布で計算 (簡易版) */
    if required_electrodes <= electrode_count then (
        /* 少なくともrequired_electrodes個成功する確率 */
        P_at_least: 0,
        /* 直接計算する代わりに近似 */
        if single_success > 0 then (
            expected_success: electrode_count * single_success,
            if required_electrodes <= expected_success then
                P_threshold: 0.95  /* 期待値以上なら高確率と仮定 */
            else
                P_threshold: 0.05  /* 期待値以下なら低確率と仮定 */
        ) else (
            P_threshold: 0.0
        )
    ) else (
        P_threshold: 0.0
    ),
    
    printf(true, "  ~30a: P = ~6,3f~%", threshold_name, P_threshold)
)$
print("")$

/* 技術的課題 */
print("6. Technical Challenges:")$
print("  -----------------------")$
challenges: [
    ["Blood-brain barrier integrity", blood_brain_barrier],
    ["Chronic inflammation", inflammation_response],
    ["Signal degradation over time", 1 - long_term_stability],
    ["Neural plasticity adaptation", 0.3]
]$

for challenge in challenges do (
    printf(true, "  ~30a: Severity = ~5,3f~%", challenge[1], challenge[2])
)$
print("")$

/* 開発ロードマップ */
print("7. Development Roadmap:")$
print("  ----------------------")$
roadmap: [
    [2025, "Basic electrode-neuron interface", 0.1],
    [2030, "Stable short-term recording", 0.3],
    [2035, "Bidirectional communication", 0.5],
    [2040, "Long-term stable integration", 0.7],
    [2045, "Full cognitive interface", 0.9]
]$

for milestone in roadmap do (
    year: milestone[1],
    description: milestone[2],
    target_prob: milestone[3],
    
    printf(true, "  ~4d: ~40a (Target: ~4,2f)~%", year, description, target_prob)
)$
print("")$

/* Python連携用出力 */
with_stdout("bio501_for_python.txt",
  printf(true, "# BIO-501 Results from Maxima~%"),
  printf(true, "total_integration_success = ~,6f~%", P_total),
  printf(true, "single_electrode_success = ~,6f~%", single_success),
  
  printf(true, "probability_components = ~%"),
  for result in results do (
    if not member(result[1], ["Total_integration_success", "Single_electrode_success", "Effective_electrodes"]) then
      printf(true, "~a,~,6f~%", result[1], result[2])
  ),
  
  printf(true, "material_comparison = ~%"),
  for material in materials do (
    material_name: material[1],
    bio_compat: material[2],
    signal_eff: material[3],
    
    /* 一時計算 */
    inflammation_response_temp: 0.3 * (1 - bio_compat),
    signal_stability_temp: signal_eff,
    
    inflammation_response_save: inflammation_response,
    signal_stability_save: signal_stability,
    
    inflammation_response: inflammation_response_temp,
    signal_stability: signal_stability_temp,
    
    results_mat: total_integration_success(),
    P_mat: 0,
    for r in results_mat do if r[1] = "Total_integration_success" then P_mat: r[2],
    
    printf(true, "~a,~,6f~%", material_name, P_mat),
    
    inflammation_response: inflammation_response_save,
    signal_stability: signal_stability_save
  ),
  
  printf(true, "electrode_optimization = ~%"),
  for count in electrode_counts do (
    electrode_count: count,
    results_count: total_integration_success(),
    P_count: 0,
    for r in results_count do if r[1] = "Total_integration_success" then P_count: r[2],
    printf(true, "~d,~,6f~%", count, P_count)
  )
);

/* 元の値に戻す */
electrode_count: electrode_count_save$

print("================================================")$
print("Calculation completed.")$
print("================================================")$

