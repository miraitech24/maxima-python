/* ============================================================ */
/* BIO-201: Ecosystem Sustainability Duration                     */
/* 生態系持続時間 - Closed ecosystem material circulation model   */
/*                                                              */
/* 【Specification】                                             */
/* 1. Ecosystem model                                            */
/*    Material circulation in a closed system                    */
/*    dN/dt = P - D                                              */
/*    N: nutrient concentration                                  */
/*    P: production rate (photosynthesis)                        */
/*    D: decomposition rate                                      */
/*                                                              */
/* 2. Sustainability criteria                                    */
/*    System is sustainable if N(t) > N_critical                 */
/*    Sustainability duration: time until N(t) < N_critical      */
/*                                                              */
/* 3. Parameters                                                 */
/*    N0: initial nutrient concentration = 100                   */
/*    P0: initial production rate = 10                           */
/*    D0: initial decomposition rate = 8                         */
/*    k_decay: decay rate of production = 0.02                   */
/*    N_crit: critical threshold = 30                            */
/*    t_max: calculation period = 200 years                      */
/*                                                              */
/* 4. Graphics                                                   */
/*    draw2d with points for 4 plots                             */
/* ============================================================ */

display2d:false;
load(draw)$

N0: 100$
P0: 10$
D0: 8$
k_decay: 0.02$
N_crit: 30$
t_max: 200$
h: 0.1$
n_steps: 2000$

print("==========================================")$
print("BIO-201: Ecosystem Sustainability Duration")$
print("==========================================")$

P(t) := P0 * exp(-k_decay * t)$
D(t) := D0 * (1 - exp(-0.01 * t))$

N_vals: makelist(0, i, 1, n_steps+1)$
N_vals[1]: N0$

for i:2 thru n_steps+1 do (
    t_val: (i-1) * h,
    p_val: P(t_val),
    d_val: D(t_val),
    N_vals[i]: N_vals[i-1] + h * (p_val - d_val),
    if N_vals[i] < 0 then N_vals[i]: 0
)$

/* 点データ生成 */
t_list: makelist(i*h, i, 0, n_steps)$
N_list: makelist(N_vals[i+1], i, 0, n_steps)$
P_list: makelist(float(P(i*h)), i, 0, n_steps)$
D_list: makelist(float(D(i*h)), i, 0, n_steps)$
dN_list: makelist(float(P(i*h)-D(i*h)), i, 0, n_steps)$

/* 間引き（200点） */
sp: 10$
t_plot: makelist(t_list[i], i, 1, n_steps+1, sp)$
N_plot: makelist(N_list[i], i, 1, n_steps+1, sp)$
P_plot: makelist(P_list[i], i, 1, n_steps+1, sp)$
D_plot: makelist(D_list[i], i, 1, n_steps+1, sp)$
dN_plot: makelist(dN_list[i], i, 1, n_steps+1, sp)$

print("Parameters:")$
print("  Initial nutrient N0 = ", N0)$
print("  Initial production P0 = ", P0)$
print("  Initial decomposition D0 = ", D0)$
print("  Production decay rate = ", k_decay)$
print("  Critical threshold N_crit = ", N_crit)$

print("")$
print("=== Nutrient concentration over time ===")$
print("Year   N(t)      P(t)      D(t)")$
for i:1 thru length(t_list) step 200 do (
    print(t_list[i], "  ", N_list[i], "  ", P_list[i], "  ", D_list[i])
)$

sustainable: true$
sustainability_years: t_max$
for i:2 thru n_steps+1 do (
    if N_vals[i] < N_crit and sustainable then (
        sustainability_years: (i-1) * h,
        sustainable: false
    )
)$

print("")$
print("=== Sustainability Analysis ===")$
print("Sustainability duration: ", float(sustainability_years), " years")$
if sustainable then print("System remains sustainable beyond ", t_max, " years")$

print("")$
print("=== Effect of Initial Production P0 ===")$
print("P0        Sustainability (years)")$
for p0_test in [5, 8, 10, 12, 15] do (
    block([local_N: makelist(0, i, 1, n_steps+1), i, t_val, p_val, d_val, sf: true, sy: t_max],
        local_N[1]: N0,
        for i:2 thru n_steps+1 do (
            t_val: (i-1) * h,
            p_val: p0_test * exp(-k_decay * t_val),
            d_val: D0 * (1 - exp(-0.01 * t_val)),
            local_N[i]: local_N[i-1] + h * (p_val - d_val),
            if local_N[i] < 0 then local_N[i]: 0,
            if local_N[i] < N_crit and sf then (sy: (i-1) * h, sf: false)
        ),
        print(p0_test, "  ", float(sy))
    )
)$

/* Fig.1: Nutrient concentration over time */
thresh_plot: makelist(N_crit, i, 1, length(t_plot))$
draw2d(
    title = "Fig.1: Nutrient Concentration over Time",
    xlabel = "Time (years)", ylabel = "Nutrient Concentration N(t)",
    key = "N(t)",
    points(t_plot, N_plot),
    color = blue, line_width = 2,
    key = "Critical threshold",
    points(t_plot, thresh_plot),
    color = red, line_width = 2, line_type = dots,
    grid = true
)$

/* Fig.2: Production and decomposition rates */
draw2d(
    title = "Fig.2: Production and Decomposition Rates",
    xlabel = "Time (years)", ylabel = "Rate",
    key = "Production P(t)",
    points(t_plot, P_plot),
    color = green, line_width = 2,
    key = "Decomposition D(t)",
    points(t_plot, D_plot),
    color = orange, line_width = 2,
    grid = true
)$

/* Fig.3: Net change rate */
draw2d(
    title = "Fig.3: Net Change Rate dN/dt",
    xlabel = "Time (years)", ylabel = "dN/dt = P(t) - D(t)",
    key = "dN/dt",
    points(t_plot, dN_plot),
    color = purple, line_width = 2,
    grid = true
)$

/* Fig.4: Effect of initial production on sustainability */
p0_list: [5, 8, 10, 12, 15]$
sus_list: makelist(block([local_N: makelist(0, i, 1, n_steps+1), i, t_val, p_val, d_val, sf: true, sy: t_max],
    local_N[1]: N0,
    for i:2 thru n_steps+1 do (
        t_val: (i-1) * h,
        p_val: p0_test * exp(-k_decay * t_val),
        d_val: D0 * (1 - exp(-0.01 * t_val)),
        local_N[i]: local_N[i-1] + h * (p_val - d_val),
        if local_N[i] < 0 then local_N[i]: 0,
        if local_N[i] < N_crit and sf then (sy: (i-1) * h, sf: false)
    ),
    float(sy)
), p0_test, p0_list)$

draw2d(
    title = "Fig.4: Sustainability vs Initial Production",
    xlabel = "Initial Production Rate P0",
    ylabel = "Sustainability Duration (years)",
    key = "Sustainability",
    points(p0_list, sus_list),
    color = red, line_width = 2,
    grid = true
)$

print("")$
print("All 4 figures displayed")$
print("==========================================")$
print("BIO-201 analysis complete")$
print("==========================================")$
