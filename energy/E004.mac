/* E004_eval.mac
  [Purpose]
  Evaluate Tesla-type wireless power transfer (VenusFusion#26) against E004 requirements.

  [Spec from doc]
  - Frequency: 2.45 GHz band
  - 1 MW class transfer, efficiency 85% (reference)
  - Distance >= 100 km
  - Overall efficiency >= 70%
  - Cost <= 0.05 USD/kWh (5 cents/kWh)
  1

  [I/O via files]
  Read inputs from: E004_inputs.csv
  Write outputs to: E004_results_from_maxima.csv
  If input file is missing: stop (no default).
  25
*/

kill(all)$

/* ----  file names (ASCII only) ---- */
in_csv  : "E004_inputs.csv"$
out_csv : "E004_results_from_maxima.csv"$

/* ----  require input file ---- */
if file_search(in_csv) = false then (
  print("ERROR: input file not found: ", in_csv),
  quit()
)$

/* ----  parse CSV (simple: header + numeric columns) ---- */
/* Expected header:
   case_id,freq_ghz,tx_mw,dist_km,eff_total,cost_usd_per_kwh
*/
lines : readfile(in_csv)$
if length(lines) < 2 then (
  print("ERROR: CSV has no data rows."),
  quit()
)$

/* helper: split by comma */
split_csv_line(s) := stringtok(s, ",")$

header : split_csv_line(first(lines))$
data_lines : rest(lines)$

/* indices (fixed by expected header order) */
idx_case : 1$
idx_freq : 2$
idx_txmw : 3$
idx_dist : 4$
idx_eff  : 5$
idx_cost : 6$

/* requirements */
req_dist_km : 100.0$
req_eff     : 0.70$
req_cost    : 0.05$

/* evaluate each row */
results : []$
for s in data_lines do block(
  row : split_csv_line(s),

  case_id : row[idx_case],
  freq_ghz : float(parse_string(row[idx_freq])),
  tx_mw    : float(parse_string(row[idx_txmw])),
  dist_km  : float(parse_string(row[idx_dist])),
  eff_total: float(parse_string(row[idx_eff])),
  cost_usd_per_kwh : float(parse_string(row[idx_cost])),

  pass_dist : if dist_km >= req_dist_km then 1 else 0,
  pass_eff  : if eff_total >= req_eff then 1 else 0,
  pass_cost : if cost_usd_per_kwh <= req_cost then 1 else 0,
  pass_all  : if (pass_dist=1 and pass_eff=1 and pass_cost=1) then 1 else 0,

  /* delivered power and loss (simple arithmetic, not a physics model) */
  rx_mw : tx_mw * eff_total,
  loss_mw : tx_mw - rx_mw,

  results : endcons(
    [case_id, freq_ghz, tx_mw, dist_km, eff_total, cost_usd_per_kwh,
     rx_mw, loss_mw, pass_dist, pass_eff, pass_cost, pass_all],
    results
  )
)$

/* ----  write CSV ---- */
out : openw(out_csv)$
printf(out,
"case_id,freq_ghz,tx_mw,dist_km,eff_total,cost_usd_per_kwh,rx_mw,loss_mw,pass_dist,pass_eff,pass_cost,pass_all~%")$
for r in results do (
  printf(out,
"~a,~f,~f,~f,~f,~f,~f,~f,~d,~d,~d,~d~%",
    r[1],r[2],r[3],r[4],r[5],r[6],r[7],r[8],r[9],r[10],r[11],r[12]
  )
)$
close(out)$

print("OK: wrote ", out_csv)$
quit()$
2) Python（後hòu段duàn：繰qiāoり返fǎnし計jì算suàn・集jí計jì・グラフ・サマリ） E004_eval.py
# E004_eval.py
