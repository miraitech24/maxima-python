# ※効xiào率lǜやコストの距jù離lí依yī存cúnモデルは文wén書shūに無wúいため、本běnコードは入rù力lì値zhíを評píng価sìする。
# 1

import os
import sys
import csv
import subprocess
from datetime import datetime

import matplotlib.pyplot as plt

IN_CSV = "E004_inputs.csv"
MAXIMA_MAC = "E004_eval.mac"
MID_CSV = "E004_results_from_maxima.csv"

OUT_CSV = "E004_results.csv"
OUT_SUMMARY = "E004_summary.txt"
OUT_PNG = "E004_plots.png"


def fail(msg: str, code: int = 1):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def run_maxima():
    if not os.path.exists(IN_CSV):
        fail(f"input file not found: {IN_CSV}")
    if not os.path.exists(MAXIMA_MAC):
        fail(f"Maxima script not found: {MAXIMA_MAC}")

    cmd = ["maxima", "-b", MAXIMA_MAC]
    try:
        cp = subprocess.run(cmd, capture_output=True, text=True, check=False)
    except Exception as e:
        fail(f"failed to run maxima: {e}")

    if cp.returncode != 0:
        # keep it simple; show maxima stderr/stdout
        print(cp.stdout)
        print(cp.stderr, file=sys.stderr)
        fail(f"maxima failed with code {cp.returncode}")

    if not os.path.exists(MID_CSV):
        fail(f"Maxima did not produce output: {MID_CSV}")


def read_csv(path: str):
    with open(path, newline="", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        rows = list(reader)
    if not rows:
        fail(f"no rows in {path}")
    return rows


def write_csv(path: str, rows, fieldnames):
    with open(path, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fieldnames)
        w.writeheader()
        for r in rows:
            w.writerow(r)


def jp_fontname_or_none():
    # super simple font auto-detect
    candidates = [
        "IPAexGothic", "IPAGothic", "Noto Sans CJK JP",
        "Yu Gothic", "Hiragino Sans", "MS Gothic"
    ]
    try:
        import matplotlib.font_manager as fm
        installed = {f.name for f in fm.fontManager.ttflist}
        for c in candidates:
            if c in installed:
                return c
    except Exception:
        return None
    return None


def to_float(x):
    try:
        return float(x)
    except Exception:
        return float("nan")


def main():
    run_maxima()
    rows = read_csv(MID_CSV)

    # copy to final CSV (same content, but keeps artifact contract)
    fieldnames = list(rows[0].keys())
    write_csv(OUT_CSV, rows, fieldnames)

    # aggregate
    total = len(rows)
    pass_all = sum(int(r["pass_all"]) for r in rows)
    pass_dist = sum(int(r["pass_dist"]) for r in rows)
    pass_eff = sum(int(r["pass_eff"]) for r in rows)
    pass_cost = sum(int(r["pass_cost"]) for r in rows)

    # summary
    now = datetime.utcnow().isoformat() + "Z"
    with open(OUT_SUMMARY, "w", encoding="utf-8") as f:
        f.write("E004 Tesla Power Transfer Evaluation Summary\n")
        f.write(f"timestamp_utc: {now}\n")
        f.write(f"input_csv: {IN_CSV}\n")
        f.write(f"evaluated_cases: {total}\n")
        f.write(f"pass_all: {pass_all}\n")
        f.write(f"pass_dist(>=100km): {pass_dist}\n")
        f.write(f"pass_eff(>=0.70): {pass_eff}\n")
        f.write(f"pass_cost(<=0.05 USD/kWh): {pass_cost}\n")

    # plotting (2x2)
    font = jp_fontname_or_none()
    if font:
        plt.rcParams["font.family"] = font
        title_pass = "合hé格gé/不bù合hé格gé"
        x_dist = "距jù離lí(km)"
        y_eff = "総zǒng合hé効xiào率lǜ"
        y_cost = "コスト(USD/kWh)"
        y_rx = "受shòu電diàn電diàn力lì(MW)"
    else:
        title_pass = "Pass/Fail"
        x_dist = "Distance (km)"
        y_eff = "Total efficiency"
        y_cost = "Cost (USD/kWh)"
        y_rx = "Received power (MW)"

    dist = ["dist_km"]) for r in rows]
    eff = ["eff_total"]) for r in rows]
    cost = ["cost_usd_per_kwh"]) for r in rows]
    rx = ["rx_mw"]) for r in rows]
    paf = ["pass_all"]) for r in rows]

    fig, axs = plt.subplots(2, 2, figsize=(10, 7), constrained_layout=True)

    # (1) dist vs eff
    axs[0, 0].scatter(dist, eff, c=paf, cmap="coolwarm", s=30)
    axs[0, 0].set_xlabel(x_dist)
    axs[0, 0].set_ylabel(y_eff)
    axs[0, 0].set_title(f"{title_pass}: {y_eff}")

    # (2) dist vs cost
    axs[0, 1].scatter(dist, cost, c=paf, cmap="coolwarm", s=30)
    axs[0, 1].set_xlabel(x_dist)
    axs[0, 1].set_ylabel(y_cost)
    axs[0, 1].set_title(f"{title_pass}: {y_cost}")

    # (3) dist vs rx
    axs[1, 0].scatter(dist, rx, c=paf, cmap="coolwarm", s=30)
    axs[1, 0].set_xlabel(x_dist)
    axs[1, 0].set_ylabel(y_rx)
    axs[1, 0].set_title(f"{title_pass}: {y_rx}")

    # (4) pass counts
    labels = ["pass_all", "pass_dist", "pass_eff", "pass_cost"]
    values = [pass_all, pass_dist, pass_eff, pass_cost]
    axs[1, 1].bar(labels, values)
    axs[1, 1].set_title("Counts")

    fig.savefig(OUT_PNG, dpi=150)
    plt.close(fig)

    print("OK")
    print(f"- {OUT_CSV}")
    print(f"- {OUT_SUMMARY}")
    print(f"- {OUT_PNG}")


if __name__ == "__main__":
    main()
